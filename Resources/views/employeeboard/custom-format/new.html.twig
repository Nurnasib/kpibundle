{#                                                                            <td><input type="number" name="sales[{{ entity.attribute.id }}][target]" class="form-control"></td>#}
{#                                                                            <td><input type="number" name="sales[{{ entity.attribute.id }}][sales]" class="form-control"></td>#}
{#                                                                        {% endif %}#}
