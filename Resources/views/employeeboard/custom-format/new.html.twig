                                <table class="table table-bordered">
                                    <tbody>
                                    {% if board.employeeBoardAttributes is not empty %}
                                        {% for parameters in arrayData %}
                                            {% for activity in parameters %}
                                                {% for entity in activity %}
                                                    {% if loop.first %}
                                                        {% if entity.activity.slug == 'sales' %}
                                                            <tr>
                                                                <td colspan="3" class="bg-secondary"><h5 class="m-0 p-1 text-white">{{ 'Sales Feed Achivement'|trans }}</h5></td>
                                                            </tr>
                                                            <tr>
                                                                <th scope="col">{{ 'Mark Parameter'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Target Quantity'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Sales Quantity'|trans }}</th>
                                                            </tr>
                                                        {% elseif entity.activity.slug == 'sales-growth-always-consider-among-same-period' %}
                                                            <tr>
                                                                <td colspan="3" class="bg-secondary"><h5 class="m-0 p-1 text-white">{{ 'Product Sales Growth'|trans }}</h5></td>
                                                            </tr>
                                                            <tr>
                                                                <th scope="col">{{ 'Mark Parameter'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Previous Year'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Sales Quantity'|trans }}</th>
                                                            </tr>
                                                        {% elseif entity.activity.slug == 'outstanding' %}
                                                            <tr>
                                                                <td colspan="3" class="bg-secondary"><h5 class="m-0 p-1 text-white">{{ 'Outstanding'|trans }}</h5></td>
                                                            </tr>
                                                            <tr>
                                                                <th scope="col">{{ 'Mark Parameter'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Actual Amount'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Limit Amount'|trans }}</th>
                                                            </tr>
                                                        {% elseif entity.activity.slug == 'customer-development' %}
                                                            <tr>
                                                                <td colspan="3" class="bg-secondary"><h5 class="m-0 p-1 text-white">{{ 'Customer Development'|trans }}</h5></td>
                                                            </tr>
                                                            <tr>
                                                                <th scope="col">{{ 'Mark Parameter'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Total Agents'|trans }}</th>
                                                                <th scope="col" width="20%">{{ 'Upgrade Agents'|trans }}</th>
                                                            </tr>
                                                        {% endif %}
                                                    {% endif %}
                                                    <tr>
                                                        {% if entity.parameter.status == 1 %}
                                                            {% if entity.activity.status == 1 %}
                                                                {% if entity.attribute.status == 1 %}
                                                                    {% if entity.activity.slug == 'sales' %}
                                                                        <td>{{ entity.attribute.name }}</td>

                                                                        <td><input type="number" name="sales[{{ entity.attribute.id }}][target]" class="form-control"></td>
                                                                        <td><input type="number" name="sales[{{ entity.attribute.id }}][sales]" class="form-control"></td>
                                                                    {% elseif entity.activity.slug == 'sales-growth-always-consider-among-same-period' %}
                                                                        <td>{{ entity.attribute.name }}</td>

                                                                        <td><input type="number" name="growth[{{ entity.attribute.id }}][previous]" class="form-control"></td>
                                                                        <td><input type="number" name="growth[{{ entity.attribute.id }}][current]" class="form-control"></td>
                                                                    {% elseif entity.activity.slug == 'outstanding' %}
                                                                        <td>{{ entity.attribute.name }}</td>
                                                                        <td><input type="number" name="outstanding[{{ entity.attribute.id }}][actualAmount]" class="form-control"></td>
                                                                        <td><input type="number" name="outstanding[{{ entity.attribute.id }}][limitAmount]" class="form-control"></td>
                                                                    {% elseif entity.activity.slug == 'customer-development' %}
                                                                        <td>{{ entity.attribute.name }}</td>
                                                                        <td><input type="number" name="customerDevelopment[{{ entity.attribute.id }}][totalAgents]" class="form-control"></td>
                                                                        <td><input type="number" name="customerDevelopment[{{ entity.attribute.id }}][upgradeAgent]" class="form-control"></td>
                                                                    {% endif %}
                                                                {% endif %}
                                                            {% endif %}
                                                        {% endif %}
                                                    </tr>
                                                {% endfor %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}
                                    </tbody>
                                </table>
                                <div class="form-actions">
                                    <div class="col-md-6 ">
                                    </div>
                                    <div class="col-md-6 text-right">
                                        <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                            <a href="#" class="btn yellow-bg white-font"><i class="fa fa-refresh"></i>Restore</a>
                                            <button type="submit"  name="" class="btn btn-info form-submit btn">SaveAndCreate</button>
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
