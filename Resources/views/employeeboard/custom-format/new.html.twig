{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"><a
                                    href="{{ path('kpi_markchart') }}">  {{ 'Employee KPI Boards'|trans }}</a></li>
                        <li class="breadcrumb-item"><a href="javascript:">{{ 'Add New'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'KPI Element'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('kpi_board_new', {format: 'custom-format'}) }}"
                               class="btn btn-sm bg-success white-font"><i class="fas fa-plus"></i>{{ 'Custom'|trans }}
                            </a>
                            <a href="{{ path('kpi_employee_board') }}" class="btn btn-sm gray-bg white-font"><i
                                        class="fa fa-th-list"></i>{{ 'KPI Board'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row position-relative">
            <div class="card">
                <div class="portlet box green ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Manage KPI Element'|trans }} </div>
                        <div class="btn-group float-right">
                            <a href="{{ path('kpi_approve',{'id':board.id}) }}" id="statusUpdate" name="statusUpdate"
                               class="btn blue-bg text-white">Approved</a>
                            {#                            <a href="{{ path('kpi_employee_board_preview',{'id':board.id,'mode':'print'}) }}" class="btn yellow-bg white-font"><i class="fa fa-print"></i> Print</a>#}
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <style>
                            ul.header-info {
                                margin: 0;
                                padding: 0;
                                display: flex;
                                flex-wrap: wrap;
                            }

                            ul.header-info li {
                                list-style: none;
                                width: 50%;
                            }
                        </style>
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                            <tr>
                                <th colspan="2" class="text-center">KPI - {{ board.month }},{{ board.year }}</th>
                            </tr>
                            <tr>
                                <th>
                                    <ul class="header-info">
                                        <li>Name of the Employee: {{ board.employee.name }}</li>
                                        <li>Date of Joining: {% if board.employee is not empty %}{{ board.employee.joiningDate|date('d-m-Y') }}{% endif %}</li>
                                        <li>Line Manager: {% if board.employee.lineManager is not empty %}{{ board.employee.lineManager.name }}{% endif %}</li>
                                        <li>Format: {{ board.reportMode.name|default('') }}</li>
                                    </ul>
                                </th>
                                <th>
                                    <ul class="header-info">
                                        <li>Emp ID: {% if board.employee is not empty %}{{ board.employee.userId }}{% endif %}</li>
                                        <li>Designation: {% if board.employee.designation is not empty %}{{ board.employee.designation.name }}{% endif %}</li>
                                    </ul>
                                </th>
                            </tr>

                            </thead>

                        </table>
                        <form action="{{ path('custom_format_kpi', {board: board.id}) }}" method="post">
                            <h5 class="bg-secondary p-1 text-white h5 w-100 m-0">{{ 'Sales Feed Achivement' }}</h5>
                            <table class="table table-bordered" id="datatable">
                                <thead class="thead-dark">
                                <tr>
                                    <th scope="col">{{ 'Mark Parameter'|trans }}</th>
                                    <th scope="col" width="20%">{{ 'Target Quantity'|trans }}</th>
                                    <th scope="col" width="20%">{{ 'Sales Quantity'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% if board.employeeBoardAttributes is not empty %}
                                    {% if board.employeeBoardAttributes is not empty %}
                                        {% for parameters in arrayData %}
                                            {% for activity in parameters %}
                                                {% for entity in activity %}
                                                    <tr>
                                                        {% if entity.parameter.status == 1 %}
                                                            {% if entity.activity.status == 1 %}
                                                                {% if entity.activity.slug == 'sales' %}
                                                                    {% if entity.attribute.status == 1 %}
                                                                        <td>{{ entity.attribute.name }}</td>

                                                                        <td><input min="0" type="number"
                                                                                   name="sales[{{ entity.attribute.id }}][target]"
                                                                                   class="form-control"
                                                                                   value="{% if feedAndGrowth[entity.attribute.id] is defined %}{{ feedAndGrowth[entity.attribute.id]['targetQuantity'] }}{% endif %}">
                                                                        </td>
                                                                        <td><input min="0" type="number"
                                                                                   name="sales[{{ entity.attribute.id }}][sales]"
                                                                                   class="form-control"
                                                                                   value="{% if feedAndGrowth[entity.attribute.id] is defined %}{{ feedAndGrowth[entity.attribute.id]['salesQuantity'] }}{% endif %}">
                                                                        </td>
                                                                    {% endif %}
                                                                {% endif %}
                                                            {% endif %}
                                                        {% endif %}
                                                    </tr>
                                                {% endfor %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}
                                {% endif %}
                                </tbody>
                            </table>

