{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('kpi_markchart') }}">  {{ 'Settings'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Add New'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'KPI Element'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('kpi_markchart_new') }}" class="btn btn-sm  green-bg white-font"><i class="fas fa-plus"></i>{{ 'Add New'|trans }}</a>
                            <a href="{{ path('kpi_markchart') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'KPI Mark Chart'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box green ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Manage KPI Element'|trans }} </div>
                    </div>
                    <div class="portlet-body form">
                        {# New format #}
                        <div class="row">
                            <div class="col-md-2"><img src="{{ asset('assets/images/nourish.jpg') }}" alt=""></div>
                            <div class="col-md-10 text-center"><span class="h5 text-dark"><strong>KPI- for -AGM <br> Year 2021</strong></span></div>
                        </div>
                        <style>
                            ul.header-info {
                                margin: 0;
                                padding: 0;
                                display: flex;
                                flex-wrap: wrap;
                            }
                            ul.header-info li {
                                list-style: none;
                                width: 50%;
                            }
                        </style>
{#                        {{ dump(entities) }}#}
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                            <tr>
                                <th colspan="3">
                                    <ul class="header-info">
                                        <li>Name of the Employee:</li>
                                        <li>Date of Joining:</li>
                                        <li>Line Manager:</li>
                                        <li>ZONE:</li>
                                    </ul>
                                </th>
                                <th></th>
                                <th colspan="2">
                                    <ul class="header-info">
                                        <li>Emp ID:</li>
                                        <li>Designation:</li>
                                        <li>Date of Joining:</li>
                                    </ul>
                                </th>
                            </tr>
                            <tr>
                                <th>Parameter</th>
                                <th>Activity</th>
                                <th>Attributes</th>
                                <th>Marks</th>
                                <th>Mark Distribution</th>
                                <th>Obtain Marks</th>
                            </tr>
                            </thead>
                            <tboday>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tboday>
                        </table>
                        {# New format END #}



















                        <table class="table table-striped table-bordered table-hover" id="datatable">
                            <thead class="thead-dark">
                            <tr>
                                <th scope="col">Parameter</th>
                                <th scope="col" style="width: 22%">Activity</th>
                                <th scope="col" style="width: 35%">Attributes</th>
                                <th scope="col">Marks</th>
                                <th scope="col" style="width: 27%">Mark Distribution</th>
                                <th scope="col">Rating</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for entity in entities %}
                                <tr>
                                    <td class="parameter"><span>{{ entity.name }}</span></td>
                                    <td colspan="5">
                                        {% if entity.children is not empty %}
                                        <table class="activity table">
                                            {% for activity in entity.children %}
                                                <tr>
                                                    <td class="activity-name"><span>{{ activity.name }}</span></td>
                                                    <td class="activity-attribute">
                                                          {% if activity.children is not empty %}
                                                              <table class="attribute table">
                                                            {% for attribute in activity.children %}
                                                                <tr>
                                                                    <td class="attribute-name">
                                                                        {{ attribute.name }}
                                                                    </td>
                                                                    <td class="attribute-mark">
                                                                        {{ attribute.mark }}
                                                                    </td>
                                                                    <td class="attribute-markDistribution">
                                                                         {% if attribute.children is not empty %}
                                                                             {% if attribute.systemEntry == 1 %}
                                                                                 <select class="markDistribution" data-id="{{ marks[attribute.id]['id'] }}" data-action="{{ path('kpi_employee_board_attribute_update',{'id':marks[attribute.id]['id']}) }}" >
                                                                                {% for markDistribution in attribute.children %}
                                                                                    <option  value="{{ markDistribution.id }}" {% if  marks[attribute.id]['markDistributionId'] is defined and marks[attribute.id]['markDistributionId'] is not empty and markDistribution.id ==  marks[attribute.id]['markDistributionId'] %} selected="selected" {% endif %}>{{ markDistribution.name }}</option>
                                                                                {% endfor %}
                                                                            </select>
                                                                        {% else %}
                                                                                 <ul class="markDistribution">
                                                                                {% for markDistribution in attribute.children %}
                                                                                    <li>{{ markDistribution.name }}</li>
                                                                                {% endfor %}
                                                                            </ul>
                                                                             {% endif %}
                                                                         {% endif %}
                                                                    </td>
                                                                    <td class="attribute-score" id="markDistribution-{{ marks[attribute.id]['id'] }}">
                                                                        {% if marks[attribute.id] is defined and marks[attribute.id]['mark'] is not empty  %}{{ marks[attribute.id]['mark'] }}{% endif %}
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                        </table>
                                                          {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </table>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
<style>
.activity li{

}
.activity li .attribute{

}
.activity li .attribute li .markDistribution{

}

.parameter{
    position: relative;
    border-left: 34px solid #369;
    padding-left: 10px;
    width: 50px;
}

.parameter span {
    position: absolute;
    top: 50%;
    left: 30px;
    background: none;
    transform-origin: 0 0;
    transform: rotate(-90deg);
    width: 200px;
}
}

.attribute-markDistribution{
    width: 220px;
}

.markDistribution{
    padding-left: 15px;
    width: 220px;
}
.markDistribution li{
    margin-left: 0;
    padding-left: 0;
}

.activity-name{
    width: 120px;
}

.activity-attribute{
    width: 220px;
}
.attribute-name{
    width: 480px;
}
.attribute-mark{
    width: 70px;
}
.attribute-score{
    width: 70px;
}
</style>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}