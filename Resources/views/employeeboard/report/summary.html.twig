{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('kpi_employee_board') }}">  {{ 'KPI Employee Board'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Employee KPI Summary'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'KPI Summary for '|trans }}: {{ entity.employee.name }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('kpi_employee_board') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Employee Board'|trans }}</a>
                            <a href="{{ path('kpi_details_report',{'id':entity.id}) }}" class="btn btn-sm green-bg white-font"><i class="fa fa-th-list"></i>{{ 'KPI Details'|trans }}</a>
                            <a href="{{ path('kpi_summary_report_print',{'id':entity.id}) }}" target="_blank" class="btn btn-sm yellow-bg white-font"><i class="fa fa-print"></i></a>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box green ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'KPI Summary for '|trans }}: {{ entity.employee.name }} </div>
                    </div>
                      <div class="portlet-body form">
                        <div class="row form-body">
                            <div class="portlet-title">
                                <div class="caption">{{ 'Manage KPI Details for '|trans }} : {{ board.employee.name }}</div>
                            </div>
                            <style>
                                .list-unstyled li {
                                    color: #2b2e38;
                                }
                                ul.header-info {
                                    margin: 0;
                                    padding: 0;
                                    display: flex;
                                    flex-wrap: wrap;
                                }
                                ul.header-info li {
                                    list-style: none;
                                    width: 50%;
                                }
                            </style>
                            <div class="portlet-body form">
                                <div class="row form-body">
                                    <table class="table table-striped table-bordered">
                                        <thead class="thead-dark">
                                        <tr><th colspan="2" class="text-center">KPI- for {% if board.employee.reportMode is not empty %}{{ board.employee.reportMode.name }}{% endif %} <br>{{ board.month }},{{ board.year }}</th></tr>
                                        <tr>
                                            <th>
                                                <ul class="header-info">
                                                    <li>Name of the Employee: {{ board.employee.name }}</li>
                                                    <li>Date of Joining: {% if board.employee is not empty %}{{ board.employee.joiningDate|date('d-m-Y') }}{% endif %}</li>
                                                    <li>Line Manager: {% if board.employee.lineManager is not empty %}{{ board.employee.lineManager.name }}{% endif %}</li>
                                                    <li>ZONE: {% if board.employee.zonal is not empty %}{{ board.employee.zonal.name }}{% endif %}</li>
                                                </ul>
                                            </th>
                                            <th>
                                                <ul class="header-info">
                                                    <li>Emp ID: {% if board.employee is not empty %}{{ board.employee.userId }}{% endif %}</li>
                                                    <li>Designation: {% if board.employee.designation is not empty %}{{ board.employee.designation.name }}{% endif %}</li>
                                                </ul>
                                            </th>
                                        </tr>

                                        </thead>

                                    </table>
                                    {# New format END #}
                                    <table class="table table-striped table-bordered table-hover" id="datatable">
                                        <thead class="thead-dark">

                                        <tr>
                                            <th scope="col" style="width: 22%; text-align: center">Parameter</th>
                                            <th scope="col"style="text-align: center">Marks</th>
                                            <th scope="col"style="text-align: center">Weight</th>
                                            <th scope="col"style="text-align: center">Obtain Marks</th>
                                            <th scope="col"style="text-align: center">Grade</th>
                                        </tr>
                                        </thead>
                                        <tbody>

                                        {% set totalMark = 0 %}
                                        {% for entity in entities %}
                                            {% set totalMark = totalMark + entity.mark %}
                                        {% endfor %}

                                        {% set totalActualMark = 0 %}
                                        {% for entity in entities %}
                                            {% set totalActualMark = totalActualMark + entity.actualMark %}
                                            <tr>
                                                <td>{{ entity.activity }}</td>
                                                <td>{{ entity.actualMark }}</td>
                                                <td>{% if entity.mark > 0 %}{{ ((entity.mark*100)/entity.actualMark)|number_format(2) }}{% endif %}%</td>
                                                <td>{{ entity.mark }}</td>
                                                {% if loop.index==1 %}
                                                <td style="text-align: center" rowspan="{{ entities|length +1 }}">
                                                    {% set grade='' %}
                                                    {% if totalMark>=29 %}
                                                        {% set grade='A' %}
                                                    {% elseif totalMark>=27 and totalMark<29 %}
                                                        {% set grade='B+' %}
                                                    {% elseif totalMark>=25 and totalMark<27 %}
                                                        {% set grade='B' %}
                                                    {% elseif totalMark>=23 and totalMark<25 %}
                                                        {% set grade='C' %}
                                                    {% elseif totalMark<23 %}
                                                        {% set grade='D' %}
                                                    {% endif %}
                                                    {{ grade }}
                                                </td>
                                                {% endif %}
                                            </tr>
                                        {% endfor %}
                                        <tr>
                                            <th class="text-right">Total Marks</th>
                                            <th>{{ totalActualMark }}</th>
                                            <th>{{ ((totalMark*100)/totalActualMark)|number_format(2) }}%</th>
                                            <th>{{ totalMark }}</th>
                                        </tr>
                                        <tr><th colspan="6" class="text-center"><strong>A=>29,B+>27,B>25,C>23,D<23</strong></th></tr>
                                        </tbody>
                                    </table>

                                </div>
                            </div>

                        </div>
                      </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
<style>
.activity li{

}
.activity li .attribute{

}
.activity li .attribute li .markDistribution{

}

.parameter{
    position: relative;
    border-left: 34px solid #369;
    padding-left: 10px;
    width: 50px;
}

.parameter span {
    position: absolute;
    top: 50%;
    left: 30px;
    background: none;
    transform-origin: 0 0;
    transform: rotate(-90deg);
    width: 200px;
}


.attribute-markDistribution{
    width: 220px;
}

.markDistribution{
    padding-left: 15px;
    width: 220px;
}
.markDistribution li{
    margin-left: 0;
    padding-left: 0;
}

.activity-name{
    width: 120px;
}

.activity-attribute{
    width: 220px;
}
.attribute-name{
    width: 480px;
}
.attribute-mark{
    width: 70px;
}
.attribute-score{
    width: 70px;
}
</style>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}