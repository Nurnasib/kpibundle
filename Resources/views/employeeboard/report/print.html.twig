<script>
    window.print()
</script>
<table cellpadding="0" style="border-collapse: collapse;" cellspacing="0" width="100%" border="1">
    <thead>
    <tr>
        {#        <th width="100"><img src="{{ asset('/assets/images/nourish.jpg') }}" alt=""></th>#}
        <th width="100">
            <img src="data:image/jpeg;base64,"
                 alt="">
        </th>
        <th><h4>KPI- for {% if board.employee.reportMode is not empty %}{{ board.employee.reportMode.name }}{% endif %} <br>{{ board.month }},{{ board.year }}</h4></th>
    </tr>
    </thead>
</table>
<table cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; table-layout: fixed;" border="1">
    <tr>
        <th colspan="3" style="padding: 30px;">
            <div style="display: flex; flex-wrap: wrap; width: 100%">
                <p align="left"
                   style="float: left;width: 50%; display: inline-block; margin: 0px">{{ 'Name of the Employee : '|trans }}
                    {{ board.employee.name }}</p>
                <p align="right"
                   style="float: right;width: 50%;display: inline-block; margin: 0px">{{ 'Date of Joining : '|trans }}
                    {% if board.employee is not empty %}{{ board.employee.joiningDate|date('d-m-Y') }}{% endif %}</p>
            </div>
            <br>
            <div style="display: flex; flex-wrap: wrap; width: 100%">
                <p align="left"
                   style="float: left;width: 50%; display: inline-block; margin: 0px">{{ 'Line Manager : '|trans }}
                    {% if board.employee.lineManager is not empty %}{{ board.employee.lineManager.name }}{% endif %}</p>
                <p align="right"
                   style="float: right;width: 50%;display: inline-block; margin: 0px">{{ 'ZONE : '|trans }}{% if board.employee.zonal is not empty %}{{ board.employee.zonal.name }}{% endif %}</p>
            </div>
        </th>
        <th></th>
        <th colspan="2">
            <div style="display: flex; flex-wrap: wrap; width: 100%">
                <p style="float: left;width: 50%; display: inline-block; margin: 0px">{{ 'Emp ID : '|trans }} {% if board.employee is not empty %}{{ board.employee.userId }}{% endif %}</p>
                <p style="float: right;width: 50%;display: inline-block; margin: 0px">{{ 'Designation : '|trans }}
                    {% if board.employee.designation is not empty %}{{ board.employee.designation.name }}{% endif %}</p>
            </div>
        </th>
    </tr>
</table>
<style>
    .table td{
        padding-left: 5px;
    }
    .table td.text-center{
        text-align: center;
    }
</style>
<table  cellpadding="0"  style="border-collapse: collapse;"  cellspacing="0" border="1" class="table" id="datatable">
    <thead>
    <tr>
        <th scope="col">Parameter</th>
        <th scope="col" style="width: 5%;">Activity</th>
        <th scope="col" style="width: 45%">Attributes</th>
        <th scope="col">Marks</th>
        <th scope="col" style="width: 27%">Mark Distribution</th>
        <th scope="col">Obtain Marks</th>
    </tr>
    </thead>
    <tbody>
    {% if board.employeeBoardAttributes is not empty %}

        {% for parameters in arrayData %}
            {% set count=1 %}
            {% for activity in parameters %}
                {% set countActity=1 %}
                {% for entity in activity %}
                    <tr>
                        {% if(count==1) %}
                            <td rowspan="{{ parameters|multiArrayLength }}" class="parameter"><span>{{ entity.parameter.name }}</span></td>
                        {% endif %}
                        {% if(countActity==1) %}
                            <td rowspan="{{ activity|length }}" class="parameter"><span>{{ entity.activity.name }}</span></td>
                        {% endif %}
                        <td>
                            {{ entity.attribute.name }}
                        </td>
                        <td class="text-center">
                            {{ entity.attribute.mark }}
                        </td>
                        <td>
                            {% if entity.attribute.children is not empty %}
                                    <ul class="markDistribution">
                                        {% for children in entity.attribute.children %}
                                            <li>{{ children.name }}</li>
                                        {% endfor %}
                                    </ul>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {{ entity.mark }}
                        </td>
                    </tr>
                    {% set countActity=0 %}
                    {% set count=count+1 %}
                {% endfor %}
            {% endfor %}
        {% endfor %}
    {% endif %}
