<table>
    <thead>
    <tr>
        <th></th>
    </tr>
    <tr>
        <th colspan="3">
            <strong>{{ 'Agent Upgradation'|trans }}</strong>
        </th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>
            {{ 'Total Agent:' }}
            {% if agentUpgradation is defined and agentUpgradation is not empty %}{{ agentUpgradation.targetAmount|default(0) }}{% endif %}
        </td>
        <td>
            {{ 'Total Growth Agent:' }}
            {% if agentUpgradation is defined and agentUpgradation is not empty %}{{ agentUpgradation.targetAchievement|default(0) }}{% endif %}
        </td>
        <td>
            {{ 'Growth Agent percentage:' }}
            {% if agentUpgradation is defined and agentUpgradation is not empty %}{{ ((agentUpgradation.targetAchievement * 100) / agentUpgradation.targetAmount)|number_format(2)|default(0) }} % {% endif %}
        </td>
    </tr>
    </tbody>
</table>
