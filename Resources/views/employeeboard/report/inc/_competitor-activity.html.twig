{% if data['challengesCompetitorActivity'] is defined and data['challengesCompetitorActivity'] is not empty %}
<table class="table table-striped table-bordered table-hover download-excel" id="fcrReportDetails">

    <thead class="thead-dark" style="background-color: #dbdee3">

    <tr>
        <th style="width: 90px">Month</th>
        <th>Details</th>

    </tr>

    </thead>
    <tbody>
        {% for monthYear, monthYearData in data['challengesCompetitorActivity'] %}
            <tr>
                <td>{{ monthYear }}</td>
                <td style="padding-left: 20px!important;">
                    <ul>
                        {% for entity in monthYearData %}
                            <li>
                                {{ entity.description|default('') }}
                            </li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
        {% endfor %}

    </tbody>
</table>
{% endif %}
