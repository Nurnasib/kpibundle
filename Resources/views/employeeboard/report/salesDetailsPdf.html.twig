<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Sales Details Pdf</title>
    <style>
        table.employee-details tr th, table.employee-details tr td{
            padding: 2px 0px;
        }
    </style>
</head>
<body>

<div class="row">
    <div class="card">
        <div class="portlet box green ">
            <div class="portlet-body form text-dark">
                <div style="width: 100%; text-align: center; margin-top: -25px">
                    <img src="data:image/jpeg;base64," alt="">
                </div>
                <div class="row form-body">
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" class="employee-details">
                        <thead>
                        <tr>
                            <th align="left" width="25%">{{ 'Employee Name: '|trans }}</th>
                            <td align="left" >{{ entity.employee.name }}</td>
                        </tr>
                        <tr>
                            <th align="left" width="25%">{{ 'Month & Year: '|trans }}</th>
                            <td align="left" >{{ entity.month }}, {{ entity.year }}</td>
                        </tr>
                        <tr>
                            <th align="left" width="25%">{{ 'Designation: '|trans }}</th>
                            <td align="left" >{{ entity.employee.designation.name }}</td>
                        </tr>
                        <tr>
                            <th align="left" width="25%">{{ 'Working Area: '|trans }}</th>
                            <td align="left" >{% for district in entity.employee.district %}{{ district.name }}{% if not loop.last %},{% endif %} {% endfor %}</td>
                        </tr>
                        <tr>
                            <th align="left" width="25%">{{ 'Format: '|trans }}</th>
                            <td align="left" >{{ entity.employee.reportMode.name|default('') }}</td>
                        </tr>
                        {% if entity.employee.department is not empty %}
                            <tr>
                                <th align="left" width="25%">{{ 'Department: '|trans }}</th>
                                <td align="left" >{{ entity.employee.department.name }}</td>
                            </tr>
                        {% endif %}
                        </thead>
                    </table>


                    {% if feedAndGrowth is not empty %}
                        {% for key, item in feedAndGrowth|ksort %}
                            <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">{{ key == 'feed' ? 'Sales Feed Achivement' : 'Product Sales Growth' }}</h5>
                            <table width="100%" border="1" cellpadding="5" cellspacing="0">
                                <thead class="thead-dark">
                                <tr>
                                    <th scope="col">{{ 'Mark Parameter'|trans }}</th>
                                    <th scope="col" width="20%">{{ key == 'feed' ? 'Target Quantity' : 'Previous Year' }}</th>
                                    <th scope="col" width="20%">{{ 'Sales Quantity'|trans }}</th>
                                    <th scope="col" width="20%">{{ 'Percentage'|trans }}</th>
                                    <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% if item is not empty %}
                                    {% for attribute in item %}
                                        <tr>
                                            <td>{{ attribute.markParameter|default('') }}</td>
                                            <td align="right">{{ attribute.targetQuantity|default('') }}</td>
                                            <td align="right">{{ attribute.salesQuantity|default('') }}</td>
                                            <td align="right">{{ attribute.percentage|number_format(2) }} %</td>
                                            <td align="center">{{ attribute.mark|default('') }}</td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
                                    </tr>
                                {% endif %}
                                </tbody>
                            </table>
                        {% endfor %}
                    {% endif %}
                    <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">Outstanding</h5>
                    <table width="100%" border="1" cellpadding="5" cellspacing="0">
                        <thead class="thead-dark">
                        <tr>
                            <th scope="col">{{ 'District'|trans }}</th>
                            <th scope="col" width="20%">{{ 'Total Actual Amount'|trans }}</th>
                            <th scope="col" width="20%">{{ 'Total Limit Amount'|trans }}</th>
                            <th scope="col" width="20%">{{ 'Percentage'|trans }}</th>
                            <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% if outstanding is not empty %}
                            {% for key, amount in outstanding %}
                                <tr>
                                    <td>{{ key|default() }}</td>
                                    <td align="right">{{ amount.actualAmount|number_format(2,'.', ',')|default() }}</td>
                                    <td align="right">{{ amount.limitAmount|number_format(2,'.',',')|default() }}</td>
                                    <td align="right">{{ amount.percentage|number_format(2,'.')|default() }} %</td>
                                    <td align="center">{{ amount.mark|default() }}</td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
                            </tr>
                        {% endif %}
                        </tbody>
                    </table>

                    <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">DOC sales collection</h5>
                    <table width="100%" border="1" cellpadding="5" cellspacing="0">
                        <thead>
                        <tr>
                            <th scope="col">{{ 'District'|trans }}</th>
                            <th scope="col" width="20%">{{ 'Total Sales Amount'|trans }}</th>
                            <th scope="col" width="20%">{{ 'Total Collection Amount'|trans }}</th>
                            <th scope="col" width="20%">{{ 'Percentage'|trans }}</th>
                            <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% if docSale is not empty %}
                            {% for key, amount in docSale %}
                                <tr>
                                    <td>{{ key|default() }}</td>
                                    <td align="right">{{ amount.totalSalesAmount|number_format(2,'.', ',')|default() }}</td>
                                    <td align="right">{{ amount.totalCollectionAmount|number_format(2,'.',',')|default() }}</td>
                                    <td align="right">{{ amount.percentage|number_format(2,'.')|default() }} %</td>
                                    <td align="center">{{ amount.mark|default() }}</td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
                            </tr>
                        {% endif %}
                        </tbody>
                    </table>
                    {% if entity.employee.reportMode.slug == 'spo-format' %}
                        <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">Minimum 50% "D" category agents converts to "C"</h5>
                        <table width="100%" border="1" cellpadding="5" cellspacing="0">
                            <thead>
                            <tr>
                                <td scope="col">{{ 'Previous "D" Category Agents: '|trans }} {{ dCategoryUpgrade.totalAgent|default(0) }}</td>
                                <td scope="col">{{ '50% "D" Category Agents: '|trans }} {{ (dCategoryUpgrade.totalAgent / 2)|round }}</td>
                                <td scope="col">{{ 'Category Upgrade Agents: '|trans }} {{ dCategoryUpgrade.totalUpgradeAgent|default(0) }}</td>
                                <td scope="col">{{ 'Category Upgrade Percentage: '|trans }}
                                    {% if dCategoryUpgrade.totalAgent > 0 %}
                                        {{ ((dCategoryUpgrade.totalUpgradeAgent * 100) / (dCategoryUpgrade.totalAgent / 2)|round)|number_format(2) }} %
                                    {% endif %}
                                </td>
                            </tr>
                            </thead>
                        </table>
                        <table width="100%" border="1" cellpadding="5" cellspacing="0">
                            <thead>
                            <tr>
                                <th scope="col">{{ 'Category'|trans }}</th>
                                <th scope="col">{{ 'Agent Id'|trans }}</th>
                                <th scope="col">{{ 'Agent Name'|trans }}</th>
                                <th scope="col">{{ 'Region'|trans }}</th>
                                <th scope="col">{{ 'Zone'|trans }}</th>
                                <th scope="col">{{ 'Average'|trans }}</th>
                                {% if dCategoryUpgrade is not empty %}
                                    {% for entity in dCategoryUpgrade %}
                                        {% if entity is iterable and loop.index == 1 %}
                                            <th scope="col">{{ entity.month|default('') }} (Avg.)</th>
                                            <th scope="col">{{ 'Category'|trans }} {{ entity.year|default('') }}</th>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}

                            </tr>
                            </thead>
                            <tbody>

                            {% if dCategoryUpgrade is not empty %}
                                {% for row in dCategoryUpgrade %}
                                    {% if row is iterable %}
                                        <tr>
                                            <td align="center">{{ row.decemberGrade|default('') }}</td>
                                            <td align="center">{{ row.agentId|default('') }}</td>
                                            <td align="left">{{ row.agentName|default('') }}</td>
                                            <td align="left">{{ row.agentRegionName|default('') }}</td>
                                            <td align="left">{{ row.agentZoneName|default('') }}</td>
                                            <td align="right">{{ row.decemberAvg|round|default('') }}</td>
                                            <td align="right">{{ row.currentMonthAvg|round|default('') }}</td>
                                            <td align="center">{{ row.currentMonthGrade|default('') }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="10" align="center"> {{ 'No record found!'|trans }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% endif %}

                    {% if entity.employee.reportMode.slug == 'spo-format' %}
                        <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">Minimum 50 % "C" category agents converts to "B"</h5>
                        <table width="100%" cellpadding="5" cellspacing="0" border="1">
                            <thead>
                            <tr>
                                <td scope="col">{{ 'Previous "C" Category Agents: '|trans }} {{ cCategoryUpgrade.totalAgent|default(0) }}</td>
                                <td scope="col">{{ '50% "C" Category Agents: '|trans }} {{ (cCategoryUpgrade.totalAgent / 2)|round }}</td>
                                <td scope="col">{{ 'Category Upgrade Agents: '|trans }} {{ cCategoryUpgrade.totalUpgradeAgent|default(0) }}</td>
                                <td scope="col">{{ 'Category Upgrade Percentage: '|trans }}
                                    {% if cCategoryUpgrade.totalAgent > 0 %}
                                        {{ ((cCategoryUpgrade.totalUpgradeAgent * 100) / (cCategoryUpgrade.totalAgent / 2)|round)|number_format(2) }} %
                                    {% endif %}
                                </td>
                            </tr>
                            </thead>
                        </table>
                        <table width="100%" cellspacing="0" cellpadding="5" border="1">
                            <thead>
                            <tr>
                                <th scope="col">{{ 'Category'|trans }}</th>
                                <th scope="col">{{ 'Agent Id'|trans }}</th>
                                <th scope="col">{{ 'Agent Name'|trans }}</th>
                                <th scope="col">{{ 'Region'|trans }}</th>
                                <th scope="col">{{ 'Zone'|trans }}</th>
                                <th scope="col">{{ 'Average'|trans }}</th>
                                {% if cCategoryUpgrade is not empty %}
                                    {% for entity in cCategoryUpgrade %}
                                        {% if entity is iterable and loop.index == 1 %}
                                            <th scope="col">{{ entity.month|default('') }} (Avg.)</th>
                                            <th scope="col">{{ 'Category'|trans }} {{ entity.year|default('') }}</th>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}

                            </tr>
                            </thead>
                            <tbody>

                            {% if cCategoryUpgrade is not empty %}
                                {% for row in cCategoryUpgrade %}
                                    {% if row is iterable %}
                                        <tr>
                                            <td align="center">{{ row.decemberGrade|default('') }}</td>
                                            <td align="center">{{ row.agentId|default('') }}</td>
                                            <td align="left">{{ row.agentName|default('') }}</td>
                                            <td align="left">{{ row.agentRegionName|default('') }}</td>
                                            <td align="left">{{ row.agentZoneName|default('') }}</td>
                                            <td align="right">{{ row.decemberAvg|round|default('') }}</td>
                                            <td align="right">{{ row.currentMonthAvg|round|default('') }}</td>
                                            <td align="center">{{ row.currentMonthGrade|default('') }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="10" align="center"> {{ 'No record found!'|trans }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% endif %}
                    {% if (entity.employee.reportMode.slug == 'agm-kpi' or entity.employee.reportMode.slug == 'rsm-arsm-kpi') %}
                        <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">Team members ach(=100%) mark on core activities</h5>
                        <table width="100%" cellpadding="5", cellspacing="0" border="1">
                            <thead>
                            <tr>
                                <th scope="col">{{ 'Employee'|trans }}</th>
                                <th scope="col" width="20%">{{ 'Actual Mark'|trans }}</th>
                                <th scope="col" width="10%">{{ 'Mark'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if individualTeamMemberMarks is not empty %}
                                {% for key, member in individualTeamMemberMarks %}
                                    <tr>
                                        <td>{{ key|capitalize|default('') }}</td>
                                        <td align="center">{{ member.actualMark|default('') }}</td>
                                        <td align="center">{{ member.mark|default('') }}</td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% endif %}

                    {% if entity.employee.reportMode.slug == 'agm-kpi' %}
                        <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">All Regional Achievement status on Total Feed</h5>
                        <table width="100%" cellspacing="0" cellpadding="5" border="1">
                            <thead>
                            <tr>
                                <th scope="col">{{ 'Region'|trans }}</th>
                                <th scope="col" width="20%">{{ 'Total Target Quantity'|trans }}</th>
                                <th scope="col" width="20%">{{ 'Total Achieve Quantity'|trans }}</th>
                                <th scope="col" width="20%">{{ 'Percentage'|trans }}</th>
                                <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if regionalAchievement is not empty %}
                                {% for key, amount in regionalAchievement %}
                                    <tr>
                                        <td>{{ key|default() }}</td>
                                        <td align="right">{{ amount.targetQuantity|number_format(2,'.', ',')|default() }}</td>
                                        <td align="right">{{ amount.achieveQuantity|number_format(2,'.',',')|default() }}</td>
                                        <td align="right">{{ amount.percentage|number_format(2,'.')|default() }} %</td>
                                        <td align="center">{{ amount.mark|default() }}</td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% endif %}

                    {% if (entity.employee.reportMode.slug == 'agm-kpi' or entity.employee.reportMode.slug == 'rsm-arsm-kpi') %}
                        <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">All District Achievement on Total Feed</h5>
                        <table width="100%" cellpadding="5" cellspacing="0" border="1">
                            <thead>
                            <tr>
                                <th scope="col">{{ 'District'|trans }}</th>
                                <th scope="col" width="20%">{{ 'Total Target Quantity'|trans }}</th>
                                <th scope="col" width="20%">{{ 'Total Achieve Quantity'|trans }}</th>
                                <th scope="col" width="20%">{{ 'Percentage'|trans }}</th>
                                <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if districtAchievement is not empty %}
                                {% for key, amount in districtAchievement %}
                                    <tr>
                                        <td>{{ key|default() }}</td>
                                        <td align="right">{{ amount.targetQuantity|number_format(2,'.', ',')|default() }}</td>
                                        <td align="right">{{ amount.achieveQuantity|number_format(2,'.',',')|default() }}</td>
                                        <td align="right">{{ amount.percentage|number_format(2,'.')|default() }} %</td>
                                        <td align="center">{{ amount.mark|default() }}</td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% endif %}


                    {% if (entity.employee.reportMode.slug == 'spo-format' or entity.employee.reportMode.slug == 'aqua-service' or entity.employee.reportMode.slug == 'cattle-service') %}
                        <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">Agents Sales 20% Growth (Only for permanent agents: Will consider same period from previous year)</h5>
                        <table width="100%" cellspacing="0" cellpadding="5" border="1">
                            <thead>
                            <tr>
                                <td>{{ 'Total Agent:' }} {{ twentyPercentGrowthAgentSalesDetails.totalAgent|default(0) }}</td>
                                <td>{{ 'Total Growth Agent:' }} {{ twentyPercentGrowthAgentSalesDetails.growthAgent|default(0) }}</td>
                                <td>{{ '20% Growth Agent:' }} {{ twentyPercentGrowthAgentSalesDetails.twentyPercentGrowthAgents|default(0) }}</td>
                                <td>{{ '20% growth Agent percentage:' }}
                                    {% if twentyPercentGrowthAgentSalesDetails.totalAgent > 0 %}
                                        {{ ((twentyPercentGrowthAgentSalesDetails.twentyPercentGrowthAgents * 100) / twentyPercentGrowthAgentSalesDetails.totalAgent)|number_format(2) }} %

                                    {% endif %}
                                </td>
                            </tr>
                            </thead>
                        </table>
                        <table width="100%" cellpadding="5" cellspacing="0" border="1">
                            <thead>
                            <tr>
                                <th scope="col">{{ 'Agent Id'|trans }}</th>
                                <th scope="col">{{ 'Agent Name'|trans }}</th>
                                <th scope="col">{{ 'Address'|trans }}</th>
                                <th scope="col">{{ 'Total Sales'|trans }} ({{ (entity.year)-1 }})</th>
                                <th scope="col">{{ 'Total Sales'|trans }} ({{ entity.year }})</th>
                                <th scope="col">{{ 'Growth'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if twentyPercentGrowthAgentSalesDetails is not empty %}
                                {% for agentId, details in twentyPercentGrowthAgentSalesDetails %}
                                    {% if details is iterable %}
                                        {% set prevYearSale = details[entity.year-1]|number_format(2) %}
                                        {% set currentYearSale = details[entity.year]|number_format(2) %}
                                        <tr>
                                            <td align="center">{{ agentId|default('') }}</td>
                                            <td>{{ details.agentName|default('') }}</td>
                                            <td>{{ details.agentAddress|default('') }}</td>
                                            <td align="right">{{ details[entity.year-1]|number_format(2) }}</td>
                                            <td align="right">{{ details[entity.year]|number_format(2) }}</td>
                                            <td align="center">{{ (((currentYearSale - prevYearSale) * 100) / prevYearSale)|number_format(2) }}
                                                %
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="10" align="center"> {{ 'No record found!'|trans }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->
</div>
</body>
</html>