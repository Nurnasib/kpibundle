<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>KPI-Sales</title>
    <style>
        table tr td, table tr th {
            padding: 5px;
        }

        body {
            font-size: 10px !important;
        }
    </style>
</head>
<body>
<table width="100%" cellspacing="0" cellpadding="0" border="1">
    <thead>
    <tr>
        <th colspan="22">
            {{ mode|capitalize }} Percentage ({{ filterBy['startMonth'] ~ ' - ' ~ filterBy['endMonth'] }}), {{ filterBy['year'] }}
            <br>
            {% if not is_granted('ROLE_KPI_ADMIN') %}
                Line Manager: {{ '(' ~ app.user.userId ~ ') ' ~ app.user.name }}
            {% endif %}
        </th>
    </tr>
    <tr>
        <th rowspan="2">{{ 'Employee ID'|trans }}</th>
        <th rowspan="2">{{ 'Name'|trans }}</th>
        <th rowspan="2">{{ 'Designation'|trans }}</th>
        <th rowspan="2">{{ 'Month'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Broiler'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Sonali'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Layer'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Fish'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Cattle'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Total'|trans }}</th>

    </tr>
    <tr>
        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

    </tr>
    </thead>
    <tbody>
    {% if data is defined and data is not empty %}

        {% for details in data %}
            {% set employeeRecordCount = 1 %}
            {% for month, kpiMonth in details['kpiMonths'] %}
                <tr>
                    {% if employeeRecordCount==1 %}
                        <td rowspan="{{ details['kpiMonths']|length }}">{{ details['userInfo'].userId }}</td>
                        <td rowspan="{{ details['kpiMonths']|length }}">{{ details['userInfo'].name }}</td>
                        <td rowspan="{{ details['kpiMonths']|length }}">{{ details['userInfo'].designation }}</td>
                    {% endif %}
                    <td>{{ kpiMonth }}</td>

                    <td>{{ details['data'][month]['Broiler'] is defined ? details['data'][month]['Broiler'].totalTargetQuantity|number_format(2) : '' }}</td>
                    <td>{{ details['data'][month]['Broiler'] is defined ? details['data'][month]['Broiler'].totalSalesQuantity|number_format(2) : '' }}</td>
                    <td align="center">
                        {% if mode is same as 'feed' %}
                            {% if details['data'][month]['Broiler'] is defined and details['data'][month]['Broiler'].totalTargetQuantity > 0 %}
                                {#                                                {{ (((details['data'][month]['Broiler'].totalSalesQuantity / details['data'][month]['Broiler'].totalTargetQuantity) - 1) * 100)|number_format(2) }}#}
                                {{ ((details['data'][month]['Broiler'].totalSalesQuantity*100) / details['data'][month]['Broiler'].totalTargetQuantity)|number_format(2) }}
                            {% endif %}
                        {% else %}
                            {% if details['data'][month]['Broiler'] is defined and details['data'][month]['Broiler'].totalTargetQuantity > 0 %}
                                {{ (((details['data'][month]['Broiler'].totalSalesQuantity / details['data'][month]['Broiler'].totalTargetQuantity) - 1) * 100)|number_format(2) }}
                            {% endif %}
                        {% endif %}

                    </td>

                    <td>{{ details['data'][month]['Sonali'] is defined ? details['data'][month]['Sonali'].totalTargetQuantity|number_format(2) : '' }}</td>
                    <td>{{ details['data'][month]['Sonali'] is defined ? details['data'][month]['Sonali'].totalSalesQuantity|number_format(2) : '' }}</td>
                    <td align="center">
                        {% if mode is same as 'feed' %}
                            {% if details['data'][month]['Sonali'] is defined and details['data'][month]['Sonali'].totalTargetQuantity > 0 %}
                                {{ ((details['data'][month]['Sonali'].totalSalesQuantity*100) / details['data'][month]['Sonali'].totalTargetQuantity)|number_format(2) }}
                            {% endif %}
                        {% else %}
                            {% if details['data'][month]['Sonali'] is defined and details['data'][month]['Sonali'].totalTargetQuantity > 0 %}
                                {{ (((details['data'][month]['Sonali'].totalSalesQuantity / details['data'][month]['Sonali'].totalTargetQuantity) - 1) * 100)|number_format(2) }}
                                {#                                                    {{ ((details['data'][month]['Sonali'].totalSalesQuantity*100) / details['data'][month]['Sonali'].totalTargetQuantity)|number_format(2) }}#}
                            {% endif %}
                        {% endif %}

                    </td>

                    <td>{{ details['data'][month]['Layer'] is defined ? details['data'][month]['Layer'].totalTargetQuantity|number_format(2) : '' }}</td>
                    <td>{{ details['data'][month]['Layer'] is defined ? details['data'][month]['Layer'].totalSalesQuantity|number_format(2) : '' }}</td>
                    <td align="center">

                        {% if mode is same as 'feed' %}
                            {% if details['data'][month]['Layer'] is defined and details['data'][month]['Layer'].totalTargetQuantity > 0 %}
                                {{ ((details['data'][month]['Layer'].totalSalesQuantity*100) / details['data'][month]['Layer'].totalTargetQuantity)|number_format(2) }}
                            {% endif %}
                        {% else %}
                            {% if details['data'][month]['Layer'] is defined and details['data'][month]['Layer'].totalTargetQuantity > 0 %}
                                {{ (((details['data'][month]['Layer'].totalSalesQuantity / details['data'][month]['Layer'].totalTargetQuantity) - 1) * 100)|number_format(2) }}
                                {#                                                    {{ ((details['data'][month]['Layer'].totalSalesQuantity*100) / details['data'][month]['Layer'].totalTargetQuantity)|number_format(2) }}#}
                            {% endif %}
                        {% endif %}

                    </td>

                    <td>{{ details['data'][month]['Fish'] is defined ? details['data'][month]['Fish'].totalTargetQuantity|number_format(2) : '' }}</td>
                    <td>{{ details['data'][month]['Fish'] is defined ? details['data'][month]['Fish'].totalSalesQuantity|number_format(2) : '' }}</td>
                    <td align="center">

                        {% if mode is same as 'feed' %}
                            {% if details['data'][month]['Fish'] is defined and details['data'][month]['Fish'].totalTargetQuantity > 0 %}
                                {{ ((details['data'][month]['Fish'].totalSalesQuantity*100) / details['data'][month]['Fish'].totalTargetQuantity)|number_format(2) }}
                            {% endif %}
                        {% else %}
                            {% if details['data'][month]['Fish'] is defined and details['data'][month]['Fish'].totalTargetQuantity > 0 %}
                                {{ (((details['data'][month]['Fish'].totalSalesQuantity / details['data'][month]['Fish'].totalTargetQuantity) - 1) * 100)|number_format(2) }}
                                {#                                                    {{ ((details['data'][month]['Fish'].totalSalesQuantity*100) / details['data'][month]['Fish'].totalTargetQuantity)|number_format(2) }}#}
                            {% endif %}
                        {% endif %}

                    </td>

                    <td>{{ details['data'][month]['Cattle'] is defined ? details['data'][month]['Cattle'].totalTargetQuantity|number_format(2) : '' }}</td>
                    <td>{{ details['data'][month]['Cattle'] is defined ? details['data'][month]['Cattle'].totalSalesQuantity|number_format(2) : '' }}</td>
                    <td align="center">

                        {% if mode is same as 'feed' %}
                            {% if details['data'][month]['Cattle'] is defined and details['data'][month]['Cattle'].totalTargetQuantity > 0 %}
                                {{ ((details['data'][month]['Cattle'].totalSalesQuantity*100) / details['data'][month]['Cattle'].totalTargetQuantity)|number_format(2) }}
                            {% endif %}
                        {% else %}
                            {% if details['data'][month]['Cattle'] is defined and details['data'][month]['Cattle'].totalTargetQuantity > 0 %}
                                {{ (((details['data'][month]['Cattle'].totalSalesQuantity / details['data'][month]['Cattle'].totalTargetQuantity) - 1) * 100)|number_format(2) }}
                                {#                                                    {{ ((details['data'][month]['Cattle'].totalSalesQuantity*100) / details['data'][month]['Cattle'].totalTargetQuantity)|number_format(2) }}#}
                            {% endif %}
                        {% endif %}

                    </td>

                    <td>
                        {{ (details['data'][month]|arraySumColWise('totalTargetQuantity'))|number_format(2) }}
                        {#                                            {{ details['sum']['sumTargetQuantity'] |number_format(2) }}#}
                    </td>
                    <td>
                        {{ (details['data'][month]|arraySumColWise('totalSalesQuantity'))|number_format(2) }}
                        {#                                            {{ details['sum']['sumSalesQuantity'] |number_format(2) }}#}
                    </td>
                    <td align="center">

                        {% if mode is same as 'feed' %}
                            {% if (details['data'][month]|arraySumColWise('totalSalesQuantity')) > 0 %}
                                {{ (((details['data'][month]|arraySumColWise('totalSalesQuantity'))*100) / (details['data'][month]|arraySumColWise('totalTargetQuantity')))|number_format(2) }}
                            {% endif %}
                        {% else %}
                            {% if (details['data'][month]|arraySumColWise('totalSalesQuantity')) > 0 %}
                                {{ ((((details['data'][month]|arraySumColWise('totalSalesQuantity')) / (details['data'][month]|arraySumColWise('totalTargetQuantity'))) - 1) * 100)|number_format(2) }}
                                {#                                                                                                    {{ (((details['data'][month]|arraySumColWise('totalSalesQuantity'))*100) / (details['data'][month]|arraySumColWise('totalTargetQuantity')))|number_format(2) }}#}
                            {% endif %}
                        {% endif %}

                    </td>
                </tr>
                {% set employeeRecordCount = employeeRecordCount+1 %}
            {% endfor %}
        {% endfor %}
    {% else %}
        <tr>
            <td colspan="21" align="center">{{ 'No records found'|trans }}</td>
        </tr>
    {% endif %}

    </tbody>
</table>
</body>
</html>