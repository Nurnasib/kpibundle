<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>KPI-Sales</title>
    <style>
        table tr td, table tr th {
            padding: 5px;
        }

        body {
            font-size: 10px !important;
        }
    </style>
</head>
<body>
<table width="100%" cellspacing="0" cellpadding="0" border="1">
    <thead>
    <tr>
        <th colspan="21">
            {{ mode|capitalize }} Percentage ({{ filterBy['startMonth'] ~ ' - ' ~ filterBy['endMonth'] }}), {{ filterBy['year'] }}
            <br>
            {% if not is_granted('ROLE_KPI_ADMIN') %}
                Line Manager: {{ '(' ~ app.user.userId ~ ') ' ~ app.user.name }}
            {% endif %}
        </th>
    </tr>
    <tr>
        <th rowspan="2">{{ 'Employee ID'|trans }}</th>
        <th rowspan="2">{{ 'Name'|trans }}</th>
        <th rowspan="2">{{ 'Designation'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Broiler'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Sonali'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Layer'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Fish'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Cattle'|trans }}</th>
        <th colspan="3" class="text-center">{{ 'Total'|trans }}</th>

    </tr>
    <tr>
        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

        <th class="text-center">{{ mode is same as 'feed' ? 'Target'|trans : (filterBy['year'] - 1)|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? 'Achieve'|trans : filterBy['year']|trans }}</th>
        <th class="text-center">{{ mode is same as 'feed' ? '%': 'Growth(%)' }}</th>

    </tr>
    </thead>
    <tbody>
    {% if data is defined and data is not empty %}

        {% for details in data %}
            <tr>
                <td>{{ details['userInfo'].userId }}</td>
                <td>{{ details['userInfo'].name }}</td>
                <td>{{ details['userInfo'].designation }}</td>

                <td align="right">{{ details['data']['Broiler'] is defined ? details['data']['Broiler'].totalTargetQuantity|number_format(2) : '' }}</td>
                <td align="right">{{ details['data']['Broiler'] is defined ? details['data']['Broiler'].totalSalesQuantity|number_format(2) : '' }}</td>
                <td align="center">
                    {% if details['data']['Broiler'] is defined and details['data']['Broiler'].totalTargetQuantity > 0 %}
{#                        {{ (((details['data']['Broiler'].totalSalesQuantity / details['data']['Broiler'].totalTargetQuantity) - 1) * 100)|number_format(2) }}#}
                        {{ ((details['data']['Broiler'].totalSalesQuantity*100) / details['data']['Broiler'].totalTargetQuantity)|number_format(2) }}
                    {% endif %}
                </td>

                <td align="right">{{ details['data']['Sonali'] is defined ? details['data']['Sonali'].totalTargetQuantity|number_format(2) : '' }}</td>
                <td align="right">{{ details['data']['Sonali'] is defined ? details['data']['Sonali'].totalSalesQuantity|number_format(2) : '' }}</td>
                <td align="center">
                    {% if details['data']['Sonali'] is defined and details['data']['Sonali'].totalTargetQuantity > 0 %}
                        {{ ((details['data']['Sonali'].totalSalesQuantity*100) / details['data']['Sonali'].totalTargetQuantity)|number_format(2) }}
                    {% endif %}
                </td>

                <td align="right">{{ details['data']['Layer'] is defined ? details['data']['Layer'].totalTargetQuantity|number_format(2) : '' }}</td>
                <td align="right">{{ details['data']['Layer'] is defined ? details['data']['Layer'].totalSalesQuantity|number_format(2) : '' }}</td>
                <td align="center">
                    {% if details['data']['Layer'] is defined and details['data']['Layer'].totalTargetQuantity > 0 %}
                        {{ ((details['data']['Layer'].totalSalesQuantity*100) / details['data']['Layer'].totalTargetQuantity)|number_format(2) }}
                    {% endif %}
                </td>

                <td align="right">{{ details['data']['Fish'] is defined ? details['data']['Fish'].totalTargetQuantity|number_format(2) : '' }}</td>
                <td align="right">{{ details['data']['Fish'] is defined ? details['data']['Fish'].totalSalesQuantity|number_format(2) : '' }}</td>
                <td align="center">
                    {% if details['data']['Fish'] is defined and details['data']['Fish'].totalTargetQuantity > 0 %}
                        {{ ((details['data']['Fish'].totalSalesQuantity*100) / details['data']['Fish'].totalTargetQuantity)|number_format(2) }}
                    {% endif %}
                </td>

                <td align="right">{{ details['data']['Cattle'] is defined ? details['data']['Cattle'].totalTargetQuantity|number_format(2) : '' }}</td>
                <td align="right">{{ details['data']['Cattle'] is defined ? details['data']['Cattle'].totalSalesQuantity|number_format(2) : '' }}</td>
                <td align="center">
                    {% if details['data']['Cattle'] is defined and details['data']['Cattle'].totalTargetQuantity > 0 %}
                        {{ ((details['data']['Cattle'].totalSalesQuantity*100) / details['data']['Cattle'].totalTargetQuantity)|number_format(2) }}
                    {% endif %}
                </td>

                <td align="right">{{ details['sum']['sumTargetQuantity'] |number_format(2) }}</td>
                <td align="right">{{ details['sum']['sumSalesQuantity'] |number_format(2) }}</td>
                <td align="center">
                    {% if details['sum']['sumSalesQuantity'] > 0 %}
                        {{ ((details['sum']['sumSalesQuantity']*100) / details['sum']['sumTargetQuantity'])|number_format(2) }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    {% else %}
        <tr>
            <td colspan="21" align="center">{{ 'No records found'|trans }}</td>
        </tr>
    {% endif %}

    </tbody>
</table>
</body>
</html>