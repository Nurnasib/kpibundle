{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"><a
                                    href="{{ path('kpi_employee_board') }}">  {{ 'KPI Employee Board'|trans }}</a></li>
                        <li class="breadcrumb-item"><a href="javascript:">{{ 'Team Member Summary'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Monthly KPI Status' }}</h5>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <div class="col-md-4 offset-4">
                        <form action="{{ path('monthly_generated_kpi_status') }}" method="get">
                            <table class="table table-striped table-bordered table-hover dataTable">
                                <thead class="thead-dark">
                                <tr role="row" class="filter">
                                    <th colspan="2">
                                        {% set minYear = 2020 %}
                                        {% set maxYear = "now"|date("Y") %}
                                        <select class="form-control" id="districtSalesTargetYear" name="year">
                                            <option value="">Select Year</option>

                                            {% for yearList in minYear..maxYear %}
                                                <option {{ yearList == year ? 'selected':'' }}
                                                        value="{{ yearList }}">{{ yearList }}</option>
                                                {% set yearList = yearList + 1 %}
                                            {% endfor %}
                                        </select>
                                    </th>

                                    <th colspan="1">
                                        <div class="btn-group">
                                            <button type="submit" title="search" class="btn btn-primary btn-sm"><i
                                                        class="fa fa-search" aria-hidden="true"></i></button>
                                            <a href="{{ path('monthly_generated_kpi_status') }}"
                                               class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i
                                                        class="fa fa-refresh" aria-hidden="true"></i></a>
                                        </div>
                                    </th>
                                </tr>
                                </thead>
                            </table>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% if members is defined %}
            <div class="row">
                <div class="card">
                    <div class="card-header pt-0 pb-0">
                    </div>
                    <div class="card-body" style="padding: 0; margin: 10px; overflow: auto">
                        <table class="table table-striped table-bordered table-hover" width="100%" id="details-table">
                            <thead class="thead-dark">
                            <tr>
                                <th>S/L</th>
                                <th>Username</th>
                                <th>Employee ID</th>
                                <th>Name</th>
                                {% for month in 1..12 %}
                                    {% set date = month ~ "/1/2021" %}
                                    <th>{{ date|date("F") }}</th>
                                {% endfor %}
                            </tr>
                            </thead>
                            <tbody>
                            {% if members is not empty %}
                                {% for member in members %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ member.username|default('') }}</td>
                                        <td>{{ member.userId|default('') }}</td>
                                        <td>{{ member.name|default('') }}</td>
                                        {% for month in 1..12 %}
                                            {% set date = month ~ "/1/2021" %}
                                            {% set monthName = date|date("F") %}
                                            <td align="center">

                                                {% if kpiRecords[member.userId][monthName] is defined %}
                                                    <i class="fa fa-check green-font btn-mini btn-transparent"></i>
                                                {% else %}
                                                    <i class="fa fa-remove red-font btn-mini btn-transparent"></i>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="16" align="center">{{ 'No Records Found!' }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                            <tfoot>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
 {% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock %}
{% block documentready %}
    {{ parent() }}
{% endblock %}