{% if (board.employee.reportMode.slug == 'agm-kpi' or board.employee.reportMode.slug == 'rsm-arsm-kpi') %}

    <table>
        <thead>
        <tr>
            <th></th>
        </tr>
        <tr>
            <th colspan="3"><h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">{{ 'Team members ach(=100%) mark on core activities'|trans }}</h5></th>
        </tr>
        <tr>
            <th scope="col">{{ 'Employee'|trans }}</th>
            <th scope="col" width="20%">{{ 'Actual Mark'|trans }}</th>
            <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
            <th scope="col" width="10%">{{ 'Percentage'|trans }}</th>
            <th scope="col" width="10%">{{ 'Obtain Mark'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% if individualTeamMemberMarks is not empty %}
            {% set totalActualMark = 0 %}
            {% set totalMark = 0 %}
            {% for key, member in individualTeamMemberMarks %}
                {% if key != 'obtainMark' %}
                    {% set totalActualMark = totalActualMark + member.actualMark %}
                    {% set totalMark = totalMark + member.mark %}
                    <tr>
                        <td>{{ key|capitalize|default('') }}</td>
                        <td>{{ member.actualMark|default('') }}</td>
                        <td>{{ member.mark|default('') }}</td>
                        <td></td>
                        <td></td>
                    </tr>
                {% endif %}
            {% endfor %}
            <tr>
                <th>{{ "Total"|trans }}</th>
                <th>{{ totalActualMark|default('0') }}</th>
                <th>{{ totalMark|default('0') }}</th>
                <th>{{ ((totalMark * 100) / totalActualMark)|number_format(2)|default(0) }} %</th>
                <th>{{ individualTeamMemberMarks['obtainMark']|default('0') }}</th>
            </tr>
        {% else %}
            <tr>
                <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
            </tr>
        {% endif %}
        </tbody>
    </table>
{% endif %}

{% if (board.employee.reportMode.slug == 'spo-format' or board.employee.reportMode.slug == 'aqua-service' or board.employee.reportMode.slug == 'cattle-service') %}

    <table>
        <thead>
        <tr>
            <th></th>
        </tr>
        <tr>
            <th colspan="4">
                <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">{{ 'Agent Upgradation'|trans }}</h5>
            </th>
        </tr>
        <tr>
            <td>{{ 'Total Agent:' }} {{ growthAgentSalesDetails.totalAgent|default(0) }}</td>
            <td>{{ 'Total Growth Agent:' }} {{ growthAgentSalesDetails.growthAgent|default(0) }}</td>
{#            <td>{{ '20% Growth Agent:' }} {{ growthAgentSalesDetails.twentyPercentGrowthAgents|default(0) }}</td>#}
            <td>{{ 'Growth Agent percentage:' }}
                {% if growthAgentSalesDetails.totalAgent > 0 %}
                    {{ ((growthAgentSalesDetails.growthAgent * 100) / growthAgentSalesDetails.totalAgent)|number_format(2) }} %

                {% endif %}
            </td>
        </tr>
        </thead>
    </table>
    <table>
        <thead>
        <tr>
            <th scope="col">{{ 'Agent Id'|trans }}</th>
            <th scope="col">{{ 'Agent Name'|trans }}</th>
            <th scope="col">{{ 'Address'|trans }}</th>
            <th scope="col">{{ 'Total Sales'|trans }} ({{ (board.year)-1 }})</th>
            <th scope="col">{{ 'Total Sales'|trans }} ({{ board.year }})</th>
            <th scope="col">{{ 'Growth'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% if growthAgentSalesDetails is not empty %}
            {% for agentId, details in growthAgentSalesDetails %}
                {% if details is iterable %}
                    {% set prevYearSale = details[board.year-1] %}
                    {% set currentYearSale = details[board.year] %}
                    <tr>
                        <td align="center">{{ agentId|default('') }}</td>
                        <td>{{ details.agentName|default('') }}</td>
                        <td>{{ details.agentAddress|default('') }}</td>
                        <td align="right">{{ details[board.year-1]|number_format(2) }}</td>
                        <td align="right">{{ details[board.year]|number_format(2) }}</td>
                        <td align="center">{{ (((currentYearSale - prevYearSale) * 100) / prevYearSale)|number_format(2) }}
                            %
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="10" align="center"> {{ 'No record found!'|trans }}</td>
            </tr>
        {% endif %}
        </tbody>
    </table>
{% endif %}