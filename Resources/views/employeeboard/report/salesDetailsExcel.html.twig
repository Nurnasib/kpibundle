{% if entity.employee.reportMode.slug == 'spo-format' %}
    <table>
        <thead>
        <tr>
            <th></th>
        </tr>
        <tr>
            <th colspan="4"><h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">Minimum 50% "D"
                    category agents converts to "C"</h5></th>
        </tr>
        <tr>
            <td scope="col">{{ 'Previous "D" Category Agents: '|trans }} {{ dCategoryUpgrade.totalAgent|default(0) }}</td>
            <td scope="col">{{ '50% "D" Category Agents: '|trans }} {{ (dCategoryUpgrade.totalAgent / 2)|round }}</td>
            <td scope="col">{{ 'Category Upgrade Agents: '|trans }} {{ dCategoryUpgrade.totalUpgradeAgent|default(0) }}</td>
            <td scope="col">{{ 'Category Upgrade Percentage: '|trans }}
                {% if dCategoryUpgrade.totalAgent > 0 %}
                    {{ ((dCategoryUpgrade.totalUpgradeAgent * 100) / (dCategoryUpgrade.totalAgent / 2)|round)|number_format(2) }} %
                {% endif %}
            </td>
        </tr>
        </thead>
    </table>
    <table>
        <thead>
        <tr>
            <th scope="col">{{ 'Category'|trans }}</th>
            <th scope="col">{{ 'Agent Id'|trans }}</th>
            <th scope="col">{{ 'Agent Name'|trans }}</th>
            <th scope="col">{{ 'Region'|trans }}</th>
            <th scope="col">{{ 'Zone'|trans }}</th>
            <th scope="col">{{ 'Average'|trans }}</th>
            {% if dCategoryUpgrade is not empty %}
                {% for entity in dCategoryUpgrade %}
                    {% if entity is iterable and loop.index == 1 %}
                        <th scope="col">{{ entity.month|default('') }} (Avg.)</th>
                        <th scope="col">{{ 'Category'|trans }} {{ entity.year|default('') }}</th>
                    {% endif %}
                {% endfor %}
            {% endif %}

        </tr>
        </thead>
        <tbody>

        {% if dCategoryUpgrade is not empty %}
            {% for row in dCategoryUpgrade %}
                {% if row is iterable %}
                    <tr>
                        <td align="center">{{ row.decemberGrade|default('') }}</td>
                        <td align="center">{{ row.agentId|default('') }}</td>
                        <td align="left">{{ row.agentName|default('') }}</td>
                        <td align="left">{{ row.agentRegionName|default('') }}</td>
                        <td align="left">{{ row.agentZoneName|default('') }}</td>
                        <td align="right">{{ row.decemberAvg|round|default('') }}</td>
                        <td align="right">{{ row.currentMonthAvg|round|default('') }}</td>
                        <td align="center">{{ row.currentMonthGrade|default('') }}</td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="10" align="center"> {{ 'No record found!'|trans }}</td>
            </tr>
        {% endif %}
        </tbody>
    </table>
{% endif %}

