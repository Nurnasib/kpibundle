<table>
    <thead>
    <tr>
        <th align="left" width="25%">{{ 'Employee Name: '|trans }}</th>
        <td align="left">{{ board.employee.name }}</td>
    </tr>
    <tr>
        <th align="left" width="25%">{{ 'Employee Id: '|trans }}</th>
        <td align="left">{{ board.employee.userId }}</td>
    </tr>
    <tr>
        <th align="left" width="25%">{{ 'Month & Year: '|trans }}</th>
        <td align="left">{{ board.month }}, {{ board.year }}</td>
    </tr>
    <tr>
        <th align="left" width="25%">{{ 'Designation: '|trans }}</th>
        <td align="left">{{ board.employee.designation.name }}</td>
    </tr>
    <tr>
        <th align="left" width="25%">{{ 'Working Area: '|trans }}</th>
        <td align="left">{% for district in board.employee.district %}{{ district.name }}{% if not loop.last %},{% endif %} {% endfor %}</td>
    </tr>
    <tr>
        <th align="left" width="25%">{{ 'Format: '|trans }}</th>
        <td align="left">{{ board.employee.reportMode.name|default('') }}</td>
    </tr>
    {% if board.employee.department is not empty %}
        <tr>
            <th align="left" width="25%">{{ 'Department: '|trans }}</th>
            <td align="left">{{ board.employee.department.name }}</td>
        </tr>
    {% endif %}
    </thead>
</table>

{% if feedAndGrowth is not empty %}
    {% for key, item in feedAndGrowth|ksort %}
        <table>
            <thead>
            <tr>
                <th></th>
            </tr>
            <tr>
                <th colspan="5"><h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">{{ key == 'feed' ? 'Sales Feed Achivement' : 'Product Sales Growth' }}</h5>
                </th>
            </tr>
            <tr>
                <th scope="col">{{ 'Mark Parameter'|trans }}</th>
                <th scope="col" width="20%">{{ key == 'feed' ? 'Target Quantity' : 'Previous Year' }}</th>
                <th scope="col" width="20%">{{ 'Sales Quantity'|trans }}</th>
                <th scope="col" width="20%">{{ 'Percentage'|trans }}</th>
                <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% if item is not empty %}
                {% for attribute in item %}
                    <tr>
                        <td>{{ attribute.markParameter|default('') }}</td>
                        <td align="right">{{ attribute.targetQuantity|default('') }}</td>
                        <td align="right">{{ attribute.salesQuantity|default('') }}</td>
                        <td align="right">{{ attribute.percentage|number_format(2) }} %</td>
                        <td align="center">{{ attribute.mark|default('') }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="5" align="center">{{ 'No record found!'|trans }}</td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    {% endfor %}
{% endif %}
<table>
    <thead>
    <tr>
        <th></th>
    </tr>
    <tr>
        <th colspan="5">
            <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">{{ 'Outstanding'|trans }}</h5>
        </th>
    </tr>
    <tr>
        <th scope="col">{{ 'District'|trans }}</th>
        <th scope="col" width="20%">{{ 'Total Outstanding'|trans }}</th>
        <th scope="col" width="20%">{{ 'Total Limit Amount'|trans }}</th>
        <th scope="col" width="20%">{{ 'Usage'|trans }}</th>
        <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% if outstanding is not empty %}
        {% set totalActual = 0 %}
        {% set totalLimit = 0 %}
        {% set totalOutstanding = 0 %}
        {% if board.reportMode.slug in ['custom-format-spo', 'custom-format-poultry', 'custom-format-cattle', 'custom-format-aqua'] %}

            {% set totalActual = totalActual + outstanding['actualAmount'] %}
            {% set totalLimit = totalLimit + outstanding['limitAmount'] %}
            {% set totalOutstanding = totalOutstanding + outstanding['outstanding'] %}
            <tr>
                <td></td>
                <td>{{ outstanding['actualAmount']|number_format(2,'.',',')|default() }}</td>
                <td>{{ outstanding['limitAmount']|number_format(2,'.',',')|default() }}</td>
                <td>{{ outstanding['outstanding']|number_format(2,'.')|default() }}</td>
                <td></td>
            </tr>

        {% else %}

            {% for key, amount in outstanding %}
                {% if key != 'mark' %}
                    {% set totalActual = totalActual + amount.actualAmount %}
                    {% set totalLimit = totalLimit + amount.limitAmount %}
                    {% set totalOutstanding = totalOutstanding + amount.outstanding %}
                    <tr>
                        <td>{{ key|default() }}</td>
                        <td>{{ amount.actualAmount|number_format(2,'.',',')|default() }}</td>
                        <td>{{ amount.limitAmount|number_format(2,'.',',')|default() }}</td>
                        <td>{{ amount.outstanding|number_format(2,'.')|default() }}</td>
                        <td>{{ amount.mark|default() }}</td>
                    </tr>
                {% endif %}
            {% endfor %}

        {% endif %}
        <tr>
            <th>{{ 'Total'|trans }}</th>
            <th>{{ totalActual|number_format(2,'.', ',')|default() }}</th>
            <th>{{ totalLimit|number_format(2,'.', ',')|default() }}</th>
            <th>{{ totalOutstanding|number_format(2,'.', ',')|default() }}</th>
            <td>{{ outstanding['mark']|default('') }}</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
        </tr>
    {% endif %}
    </tbody>
</table>


<table>
    <thead>
    <tr>
        <th></th>
    </tr>
    <tr>
        <th colspan="5">
            <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">{{ 'DOC sales collection'|trans }}</h5>
        </th>
    </tr>
    <tr>
        <th scope="col">{{ 'District'|trans }}</th>
        <th scope="col" width="20%">{{ 'Total Sales Amount'|trans }}</th>
        <th scope="col" width="20%">{{ 'Total Collection Amount'|trans }}</th>
        <th scope="col" width="20%">{{ 'Percentage'|trans }}</th>
        <th scope="col" width="10%">{{ 'Marks'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% if docSale is not empty %}
        {% set totalCollection = 0 %}
        {% set totalSales = 0 %}
        {% if board.reportMode.slug in ['custom-format-spo', 'custom-format-poultry', 'custom-format-cattle', 'custom-format-aqua'] %}
            {% set totalCollection = totalCollection + docSale['salesAmount'] %}
            {% set totalSales = totalSales + docSale['collectionAmount'] %}
            <tr>
                <td></td>
                <td>{{ docSale['salesAmount']|number_format(2,'.', ',')|default() }}</td>
                <td>{{ docSale['collectionAmount']|number_format(2,'.',',')|default() }}</td>
                <td></td>
                <td></td>
            </tr>
        {% else %}
            {% for key, amount in docSale %}
                {% if key != 'mark' %}
                    {% set totalCollection = totalCollection + amount.salesAmount %}
                    {% set totalSales = totalSales + amount.collectionAmount %}
                    <tr>
                        <td>{{ key|default() }}</td>
                        <td>{{ amount.salesAmount|number_format(2,'.', ',')|default() }}</td>
                        <td>{{ amount.collectionAmount|number_format(2,'.',',')|default() }}</td>
                        <td></td>
                        <td></td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% endif %}
        <tr>
            <th>{{ 'Total'|trans }}</th>
            <th>{{ totalCollection|number_format(2,'.', ',')|default(0) }}</th>
            <th>{{ totalSales|number_format(2,'.', ',')|default(0) }}</th>
            <th>{{ ((totalSales * 100) / totalCollection)|number_format(2,'.', ',')|default(0) }} %</th>
            <th>{{ docSale['mark']|default(0) }}</th>
        </tr>
    {% else %}
        <tr>
            <td colspan="10" align="center">{{ 'No record found!'|trans }}</td>
        </tr>
    {% endif %}
    </tbody>
</table>
{% if board.employee.reportMode.slug == 'spo-format' %}
    <table>
        <thead>
        <tr>
            <th></th>
        </tr>
        <tr>
            <th colspan="4">
                <h5 style="width: 100%; background: gray; padding: 5px; margin-bottom: 2px">{{ '"D" category agents converts to "C"'|trans }}</h5>
            </th>
        </tr>
        <tr>
            <td scope="col">{{ 'Previous "D" Category Agents: '|trans }} {{ dCategoryUpgrade.totalAgent|default(0) }}</td>
            <td scope="col">{{ '50% "D" Category Agents: '|trans }} {{ (dCategoryUpgrade.totalAgent / 2)|round }}</td>
            <td scope="col">{{ 'Category Upgrade Agents: '|trans }} {{ dCategoryUpgrade.totalUpgradeAgent|default(0) }}</td>
            <td scope="col">{{ 'Category Upgrade Percentage: '|trans }}
                {% if dCategoryUpgrade.totalAgent > 0 %}
                    {{ ((dCategoryUpgrade.totalUpgradeAgent * 100) / dCategoryUpgrade.totalAgent)|number_format(2) }} %
                {% endif %}
            </td>
        </tr>
        </thead>
    </table>
    <table>
        <thead>
        <tr>
            <th scope="col">{{ 'Category'|trans }}</th>
            <th scope="col">{{ 'Agent Id'|trans }}</th>
            <th scope="col">{{ 'Agent Name'|trans }}</th>
            <th scope="col">{{ 'Region'|trans }}</th>
            <th scope="col">{{ 'Zone'|trans }}</th>
            <th scope="col">{{ 'Average'|trans }}</th>
            {% if dCategoryUpgrade is not empty %}
                {% for board in dCategoryUpgrade %}
                    {% if board is iterable and loop.index == 1 %}
                        <th scope="col">{{ board.month|default('') }} (Avg.)</th>
                        <th scope="col">{{ 'Category'|trans }} {{ board.year|default('') }}</th>
                    {% endif %}
                {% endfor %}
            {% endif %}

        </tr>
        </thead>
        <tbody>

        {% if dCategoryUpgrade is not empty %}
            {% for row in dCategoryUpgrade %}
                {% if row is iterable %}
                    <tr>
                        <td align="center">{{ row.prevYearGrade|default('') }}</td>
                        <td align="center">{{ row.agentId|default('') }}</td>
                        <td align="left">{{ row.agentName|default('') }}</td>
                        <td align="left">{{ row.agentRegionName|default('') }}</td>
                        <td align="left">{{ row.agentZoneName|default('') }}</td>
                        <td align="right">{{ row.prevYearAvg|round|default('') }}</td>
                        <td align="right">{{ row.currentMonthAvg|round|default('') }}</td>
                        <td align="center">{{ row.currentMonthGrade|default('') }}</td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="10" align="center"> {{ 'No record found!'|trans }}</td>
            </tr>
        {% endif %}
        </tbody>
    </table>
{% endif %}

