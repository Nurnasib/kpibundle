{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Add New'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'KPI Report Details'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('kpi_employee_board') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Employee Board'|trans }}</a>
                            <a href="{{ path('kpi_summary_report',{'id':board.id}) }}" class="btn btn-sm green-bg white-font"><i class="fa fa-th-list"></i>{{ 'KPI Summary'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box green ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Manage KPI Details for '|trans }} : {{ board.employeeSetup.employee.name }}</div>
                    </div>
                    <style>
                        .list-unstyled li {
                            color: #2b2e38;
                        }
                    </style>
                    <div class="portlet-body form">
                        <div class="row form-body">
                            <div class="form-inner-no-space">
                                <div class="form-group">
                                    <label class="col-md-2 control-label"><strong>Employee Name</strong></label>
                                    <label class="col-md-10 control-label">{{ board.employeeSetup.employee.name }}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label"><strong>Month & Year</strong></label>
                                    <label class="col-md-10 control-label">{{ board.month }},{{ board.year }}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label"><strong>Designation</strong></label>
                                    <label class="col-md-10 control-label">{{ board.employeeSetup.employee.designation.name }}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label"><strong>Working Area</strong></label>
                                    <label class="col-md-10 control-label">{{ board.employeeSetup.employee.area }}</label>
                                </div>
                                {% if board.employeeSetup.employee.department is not empty %}
                                    <div class="form-group">
                                        <label class="col-md-2 control-label"><strong>Department</strong></label>
                                        <label class="col-md-10 control-label">{{ board.employeeSetup.employee.department.name }}</label>
                                    </div>
                                {% endif %}
                            </div>
                            <table class="table table-striped table-bordered table-hover" id="datatable">
                                <thead class="thead-dark">
                                <tr>
                                    <th scope="col">Parameter</th>
                                    <th scope="col" style="width: 22%">Activity</th>
                                    <th scope="col" style="width: 35%">Attributes</th>
                                    <th scope="col">Marks</th>
                                    <th scope="col" style="width: 27%">Mark Distribution</th>
                                    <th scope="col">Rating</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for entity in entities %}
                                    <tr>
                                        <td class="parameter"><span>{{ entity.name }}</span></td>
                                        <td colspan="5">
                                            {% if entity.children is not empty %}
                                                <table class="activity table">
                                                    {% for activity in entity.children %}
                                                        <tr>
                                                            <td class="activity-name"><span>{{ activity.name }}</span></td>
                                                            <td class="activity-attribute">
                                                                {% if activity.children is not empty %}
                                                                    <table class="attribute table">
                                                                        {% for attribute in activity.children %}
                                                                            <tr>
                                                                                <td class="attribute-name">
                                                                                    {{ attribute.name }}
                                                                                </td>
                                                                                <td class="attribute-mark">
                                                                                    {{ attribute.mark }}
                                                                                </td>
                                                                                <td class="attribute-markDistribution">
                                                                                    {% if attribute.children is not empty %}
                                                                                        {% if attribute.systemEntry == 1 %}
                                                                                            <select class="markDistribution" data-id="{{ marks[attribute.id]['id'] }}" data-action="{{ path('kpi_employee_board_attribute_update',{'entity':board.id,'id':marks[attribute.id]['id']}) }}" >
                                                                                                {% for markDistribution in attribute.children %}
                                                                                                    <option  value="{{ markDistribution.id }}" {% if  marks[attribute.id]['markDistributionId'] is defined and marks[attribute.id]['markDistributionId'] is not empty and markDistribution.id ==  marks[attribute.id]['markDistributionId'] %} selected="selected" {% endif %}>{{ markDistribution.name }}</option>
                                                                                                {% endfor %}
                                                                                            </select>
                                                                                        {% else %}
                                                                                            <ul class="markDistribution">
                                                                                                {% for markDistribution in attribute.children %}
                                                                                                    <li>{{ markDistribution.name }}</li>
                                                                                                {% endfor %}
                                                                                            </ul>
                                                                                        {% endif %}
                                                                                    {% endif %}
                                                                                </td>
                                                                                <td class="attribute-score" id="markDistribution-{{ marks[attribute.id]['id'] }}">
                                                                                    {% if marks[attribute.id] is defined and marks[attribute.id]['mark'] is not empty  %}{{ marks[attribute.id]['mark'] }}{% endif %}
                                                                                </td>
                                                                            </tr>
                                                                        {% endfor %}
                                                                    </table>
                                                                {% endif %}
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </table>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
<style>
.activity li{

}
.activity li .attribute{

}
.activity li .attribute li .markDistribution{

}

.parameter{
    position: relative;
    border-left: 34px solid #369;
    padding-left: 10px;
    width: 50px;
}

.parameter span {
    position: absolute;
    top: 50%;
    left: 30px;
    background: none;
    transform-origin: 0 0;
    transform: rotate(-90deg);
    width: 200px;
}


.attribute-markDistribution{
    width: 220px;
}

.markDistribution{
    padding-left: 15px;
    width: 220px;
}
.markDistribution li{
    margin-left: 0;
    padding-left: 0;
}

.activity-name{
    width: 120px;
}

.activity-attribute{
    width: 220px;
}
.attribute-name{
    width: 480px;
}
.attribute-mark{
    width: 70px;
}
.attribute-score{
    width: 70px;
}
</style>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}