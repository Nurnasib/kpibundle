{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('kpi_employee_board') }}">  {{ 'KPI Employee Board'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Employee Team Member Summary'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'KPI Team Member Summary for '|trans }}: {{ board.employee.name }}</h5>
                    <div class="card-header-right">
                        {% if teamMemberSummary is not empty %}
                            <div class="btn-group btn-group-sm float-right" role="group" aria-label="Button group with nested dropdown">
                                <a href="{{ path('team_member_summary',{id:board.id, mode: 'pdf'}) }}" target="_blank" class="btn blue-bg white-font btn-sm"><i class="fa fa-file-pdf"></i> PDF</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped table-bordered table-hover" width="100%">
                        <thead class="thead-dark">
                        <tr>
                            <th>Employee</th>
                            <th>Month</th>
                            <th>Year</th>
                            {% if teamMemberSummary is not empty %}
                                {% for details in teamMemberSummary %}
                                    {% if loop.first %}
                                        {% for activity, obtainMark in details %}
                                            {% if activity != 'boardId' %}
                                                <th>{{ activity }}</th>
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                            <th>Mark</th>
                            <th>Grade</th>
                            <th><i class="feather icon-settings"></i></th>
                        </tr>
                        </thead>
                        <tbody>

                        {% if teamMemberSummary is not empty %}
                            {% for employeeName, details in teamMemberSummary %}
                                {% set totalObtainMark = 0 %}
                                <tr>
                                    <td>{{ employeeName }}</td>
                                    <td>{{ board.month }}</td>
                                    <td>{{ board.year }}</td>
                                    {% for activity, obtainMark in details %}
                                        {% if activity != 'boardId' %}
                                            {% set totalObtainMark = totalObtainMark + obtainMark %}
                                            <td>{{ obtainMark|default(0) }}</td>
                                        {% endif %}
                                    {% endfor %}

                                    <td>{{ totalObtainMark }}</td>

                                    {% set grade='' %}
                                    {% if totalObtainMark >= 80 %}
                                        {% set grade='A' %}
                                    {% elseif totalObtainMark >= 75 and totalObtainMark < 80 %}
                                        {% set grade='B+' %}
                                    {% elseif totalObtainMark >= 70 and totalObtainMark < 75 %}
                                        {% set grade='B' %}
                                    {% elseif totalObtainMark >= 65 and totalObtainMark < 70 %}
                                        {% set grade='C' %}
                                    {% elseif totalObtainMark < 65 %}
                                        {% set grade='D' %}
                                    {% endif %}

                                    <td>{{ grade }}</td>
                                    <td align="right">
                                        <div class="btn-group">
                                            <a class="btn btn-mini btn-info" target="_blank" href="{{ path('kpi_details_report', {id:details.boardId}) }}"><i class="feather icon-file"></i> Details</a>
                                            <a class="btn btn-mini purple-bg white-font" target="_blank" href="{{ path('kpi_summary_report', {id:details.boardId}) }}"><i class="feather icon-file"></i> Summary</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                        </tbody>
                        <tfoot>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
<style>
.activity li{

}
.activity li .attribute{

}
.activity li .attribute li .markDistribution{

}

.parameter{
    position: relative;
    border-left: 34px solid #369;
    padding-left: 10px;
    width: 50px;
}

.parameter span {
    position: absolute;
    top: 50%;
    left: 30px;
    background: none;
    transform-origin: 0 0;
    transform: rotate(-90deg);
    width: 200px;
}


.attribute-markDistribution{
    width: 220px;
}

.markDistribution{
    padding-left: 15px;
    width: 220px;
}
.markDistribution li{
    margin-left: 0;
    padding-left: 0;
}

.activity-name{
    width: 120px;
}

.activity-attribute{
    width: 220px;
}
.attribute-name{
    width: 480px;
}
.attribute-mark{
    width: 70px;
}
.attribute-score{
    width: 70px;
}
</style>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}