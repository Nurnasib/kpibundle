         }

         .attribute-score {
             width: 70px;
         }

         @media print {

                .page-break {
                    page-break-after: always!important;
                }

             .h5{
                 color: #000000 !important;
             }
             .text-white {
                 color: #000000 !important;
             }
             .caption{
                 color: #000000 !important;
             }
             .portlet.box.green>.portlet-title, .portlet.green, .portlet>.portlet-body.green {
                 background-color: #000000 !important;
             }
         }
     </style>

 {% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock %}