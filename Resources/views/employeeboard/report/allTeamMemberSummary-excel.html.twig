<table>
    <thead>
    <tr>
        <th colspan="6" align="center">All Team Member Summary</th>
    </tr>
    {% if not is_granted('ROLE_KPI_ADMIN') %}
        <tr>
            <th colspan="6" align="center">{{ app.user.name }}</th>
        </tr>
    {% endif %}
    <tr>
        <th colspan="6"
            align="center">{{ '(' ~ filterBy.startMonth ~ ' - ' ~ filterBy.endMonth ~ ')' ~ ' - ' ~ filterBy.year }}</th>
    </tr>
    <tr>
        <th>Employee ID</th>
        <th>Employee</th>
        <th>Designation</th>
        <th>Month</th>
        {% if teamMemberSummary is not empty %}
            {% for employeeId, details in teamMemberSummary %}
                {% if loop.first %}
                    {% if details['activityName'] is not empty %}
                        {% for activityName in details['activityName'] %}
                            <th>{{ activityName|default(0) }}</th>
                        {% endfor %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        {% endif %}
        <th>Mark</th>
        <th>Grade</th>
    </tr>
    </thead>
    <tbody>
    {% if teamMemberSummary is not empty %}
        {% for employeeId, details in teamMemberSummary %}
            {% for month, activities in details['mark'] %}
                <tr>
                    <td align="center">{{ employeeId }}</td>
                    <td>{{ details['data']['employeeName'] }}</td>
                    <td>{{ details['data']['designation'] }}</td>
                    <td>{{ month }}</td>
                    {% if details['activityName'] is not empty %}
                        {% for activityName in details['activityName'] %}
                            <td align="center">{{ teamMemberSummary[employeeId]['mark'][month][activityName]|default(0) }}</td>
                        {% endfor %}
                    {% endif %}
                    <td align="center">{{ teamMemberSummary[employeeId]['data'][month]['obtainMark']|default(0) }}</td>
                    <td align="center">{{ teamMemberSummary[employeeId]['data'][month]['grade']|default('') }}</td>

                </tr>
            {% endfor %}
        {% endfor %}
    {% else %}
        <tr>
            <td colspan="6" align="center">{{ 'No record has been found!' }}</td>
        </tr>
    {% endif %}
    </tbody>
    <tfoot>
</table>
