<style>
    table tr td{
        padding: 5px;
    }
</style>
<div class="row">
    <div class="col-md-12" style="text-align: center">
        <h5>{{ 'KPI Team Member Summary for '|trans }}: {{ board.employee.name }}</h5>
    </div>
</div>
<div class="row">
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-bordered table-hover" width="100%" cellpadding="0" cellspacing="0" border="1">
                <thead class="thead-dark">
                <tr>
                    <th>Employee</th>
                    <th>Month</th>
                    <th>Year</th>
                    {% if teamMemberSummary is not empty %}
                        {% for details in teamMemberSummary %}
                            {% if loop.first %}
                                {% for activity, obtainMark in details %}
                                    {% if activity != 'boardId' %}
                                        <th>{{ activity }}</th>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    <th>Mark</th>
                    <th>Grade</th>
                </tr>
                </thead>
                <tbody>

                {% if teamMemberSummary is not empty %}
                    {% for employeeName, details in teamMemberSummary %}
                        {% set totalObtainMark = 0 %}
                        <tr>
                            <td>{{ employeeName }}</td>
                            <td>{{ board.month }}</td>
                            <td>{{ board.year }}</td>
                            {% for activity, obtainMark in details %}
                                {% if activity != 'boardId' %}
                                    {% set totalObtainMark = totalObtainMark + obtainMark %}
                                    <td>{{ obtainMark|default(0) }}</td>
                                {% endif %}
                            {% endfor %}

                            <td>{{ totalObtainMark }}</td>

                            {% set grade='' %}
                            {% if totalObtainMark >= 80 %}
                                {% set grade='A' %}
                            {% elseif totalObtainMark >= 75 and totalObtainMark < 80 %}
                                {% set grade='B+' %}
                            {% elseif totalObtainMark >= 70 and totalObtainMark < 75 %}
                                {% set grade='B' %}
                            {% elseif totalObtainMark >= 65 and totalObtainMark < 70 %}
                                {% set grade='C' %}
                            {% elseif totalObtainMark < 65 %}
                                {% set grade='D' %}
                            {% endif %}

                            <td>{{ grade }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
                <tfoot>
            </table>
        </div>
    </div>
</div>