{% extends 'admin/layout.html.twig' %}

{% block body %}
<div class="row">
    <div class="col">
        <div class="card">
            <div class="card-body">
                <table class="table table-bordered table-striped" id="datatable">
                    <thead class="thead-dark">
                    <tr>
                        <th style="text-align: center">{{ 'S/N'|trans }}</th>
                        <th>{{ 'Agent Name'|trans }}</th>
                        <th>{{ 'Quantity'|trans }}</th>
                        <th>{{ 'Grade'|trans }}</th>
                        <th>{{ 'Month'|trans }}</th>
                        <th>{{ 'Year'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if agentCategoryByMonthYear is not empty %}
                        {% for list in agentCategoryByMonthYear %}
                            <tr>
                                <td style="text-align: center">{{ loop.index }}</td>
                                <td>{{ list.agentName|default('') }}</td>
                                <td>{{ list.quantity|default('') }}</td>
                                <td>{{ list.gradeLetter|default('') }}</td>
                                <td>{{ list.month|date('F')|default('') }}</td>
                                <td>{{ list.year|default('') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align: center">{{ 'No record Found!'|trans }}</td>
                        </tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}
{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
        .ui-datepicker-calendar{display: none}
    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}

    $('#datatable').DataTable( {
    pageLength: 25,
    columnDefs: [ {
    targets: -1,
    orderable: false
    }],
    });
{% endblock %}
