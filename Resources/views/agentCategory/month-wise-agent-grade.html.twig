{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"><a
                                    href="{{ path('kpi_agent_category_index') }}"> {{ 'Agents Grade'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Agents Grade'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('kpi_agent_category_index') }}" class="btn btn-sm gray-bg white-font"><i
                                        class="fa fa-th-large"></i>{{ 'Agents Grade'|trans }}</a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-block">
                    <div class="row">
                        <div class="col">
                            <form class="form-inline border" method="get"
                                  action="{{ path('kpi_month_wise_agent_grade') }}">
                                <div class="form-group">
                                    <input autocomplete="off" type="text" class="form-control  input-sm"
                                           placeholder="mm-yyyy" value="{{ selectedMonthYear|default('') }}"
                                           name="monthYear" id="inputMonth">
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm" title="Search" value="Search"><i
                                            class="fa fa-search" aria-hidden="true"></i></button>
                            </form>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-striped table-bordered table-hover"
                                   style="margin-top: 0px !important;" id="datatable">
                                <thead class="thead-dark">
                                <tr>
                                    <th scope="col">S/N</th>
                                    <th scope="col">Id</th>
                                    <th scope="col">Agent Name</th>
                                    <th scope="col">Average</th>
                                    <th scope="col">Grade</th>
                                    <th scope="col">Month</th>
                                    <th scope="col">Year</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% if entities is not empty %}
                                    {% for entity in entities %}
                                        <tr>
                                            <td>{{ loop.index }}</td>
                                            <td>{{ entity.agentId|default('') }}</td>
                                            <td>{{ entity.agentName|default('') }}</td>
                                            <td>{{ entity.average|default('') }}</td>
                                            <td>{{ entity.grade|default('') }}</td>
                                            <td>{{ entity.month|default('') }}</td>
                                            <td>{{ entity.year|default('') }}</td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="7"
                                            style="text-align: center"> {{ 'No record found for Previous Month!'|trans }}</td>
                                    </tr>
                                {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>

{% endblock %}
{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
        .ui-datepicker-calendar {
            display: none
        }
    </style>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock %}
{% block documentready %}
    {{ parent() }}

    $('#inputMonth').datepicker({
    changeMonth: true,
    changeYear: true,
    dateFormat: 'MM,yy',

    onClose: function() {
    var iMonth = $("#ui-datepicker-div .ui-datepicker-month :selected").val();
    var iYear = $("#ui-datepicker-div .ui-datepicker-year :selected").val();
    $(this).datepicker('setDate', new Date(iYear, iMonth, 1));
    },

    beforeShow: function() {
    if ((selDate = $(this).val()).length > 0)
    {
    iYear = selDate.substring(selDate.length - 4, selDate.length);
    iMonth = jQuery.inArray(selDate.substring(0, selDate.length - 5), $(this).datepicker('option', 'monthNames'));
    $(this).datepicker('option', 'defaultDate', new Date(iYear, iMonth, 1));
    $(this).datepicker('setDate', new Date(iYear, iMonth, 1));
    }
    }
    });

    $('#datatable').DataTable({
    pageLength: 50,
    columnDefs: [ {
    targets: -1,
    orderable: false
    }],
    }
    );

{% endblock %}
