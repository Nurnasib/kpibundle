{% extends 'admin/layout.html.twig' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'District Sale'|trans }}</h5>
                </div>

            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-block">
                    <div class="row">
                    <table class="table table-striped table-bordered table-hover dataTable">
                        <thead class="thead-dark">
                        <tr role="row" class="filter">
                            <td colspan="2">
                                <input type="text" class="form-control  input-sm" placeholder="Agent Name" name="name" id="name">
                            </td>
                            <td>
                            <input  type="text" class="form-control  input-sm" name="companyName" id="companyName" placeholder="Company Name"> </td>
                            <td>
                                <input type="text" class="form-control  input-sm" placeholder="Mobile no" name="mobile" id="mobile"> </td>
                            <td colspan="2">
                                <input type="text" class="form-control  input-sm" placeholder="Email" name="email" id="email"> </td>
                        </tr>
                        <tr>
                            <th scope="col">SL</th>
                            <th scope="col">District Name</th>
                            <th scope="col">Month</th>
                            <th scope="col">Year</th>
                            {% for item in items %}
                            <th scope="col">{{ item.name }}</th>
                            {% endfor %}
                            <th scope="col" class=" text-center"><i class="feather icon-settings"></i></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entity in pagination %}
                            <tr>
                                <td scope="col">{{ loop.index }}</td>
                                <td class="districtId_{{ entity.districtId }}" scope="col">{{ entity.districtName }}</td>
                                <td scope="col">{{ entity.month }}</td>
                                <td scope="col">{{ entity.year }}</td>
                                {% for item in items %}
                                    <td class="productId_{{ item.id }}" scope="col">
                                        {{ districtSalesQty[entity.year][entity.month][entity.districtId][item.id]['quantity']|default('') }}
                                    </td>
                                {% endfor %}
                                <td></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>

                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
    <style>

    </style>
{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/core/js/app.js') }}"></script>

{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}

