{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('crm_employee') }}">  {{ 'CRM Employee'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'KPI Employee'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('kpi_employee_register') }}"   class="btn btn-sm  green-bg white-font"><i class="fa fa-plus"></i>{{ 'New Employee'|trans }}</a>
                            <a href="{{ path('kpi_employee') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-large"></i>{{ 'Employee'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-block">
                    <table class="table table-striped table-bordered table-hover" id="datatable">
                        <thead class="thead-dark">
                        <tr>
                            <td scope="col" style="padding: 0 !important;"><a href="#" class="btn btn-sm purple-bg white-font"><i class="fa fa-th"></i>RSM</a></td>
                        </tr>
                        <tr>
                            <th scope="col">S/L</th>
                            <th scope="col">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Designation</th>
                            <th scope="col">Line Manager</th>
                            <th scope="col">Report Mode</th>
                            <th scope="col">Password</th>
                            <th scope="col">Mobile</th>
                            <th scope="col" width="20%">Districts</th>
                            <th scope="col">User</th>
                            <th scope="col">Department</th>
                            <th scope="col">Status</th>
                            <th scope="col text-center"><i class="feather icon-settings"></i></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entity in entities %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ entity.userId }}</td>
                                <td>{{ entity.name }}</td>
                                <td>
                                    <a
                                            data-type="select"
                                            class="editable"
                                            id="designation-{% if entity.designation.id is defined and entity.designation.id is not empty %}{{ entity.designation.id }}{% endif %}"
                                            data-name="designation"
                                            href="#"
                                            data-source="{{ path('kpi_designation_select',{id:entity.id}) }}"
                                            data-url="{{ path('kpi_designation_inline_update',{id:entity.id}) }}"
                                            data-pk="{% if entity.designation.id is defined and entity.designation.id is not empty %}{{ entity.designation.id }}{% endif %}"
                                            data-value="{% if entity.designation.id is defined and entity.designation.id is not empty %}{{ entity.designation.id }}{% endif %}"
                                            data-original-title="Select designation">
                                        {% if entity.designation.name is defined and entity.designation.name is not empty %}{{ entity.designation.name }}{% endif %}
                                    </a>
                                </td>
                                <td>
                                    <a
                                            data-type="select"
                                            class="editable"
                                            id="lineManager-{% if entity.lineManager.id is defined and entity.lineManager.id is not empty %}{{ entity.lineManager.id }}{% endif %}"
                                            data-name="lineManager"
                                            href="#"
                                            data-source="{{ path('kpi_line_manager_select',{id:entity.id}) }}"
                                            data-url="{{ path('kpi_line_manager_inline_update',{id:entity.id}) }}"
                                            data-pk="{% if entity.lineManager.id is defined and entity.lineManager.id is not empty %}{{ entity.lineManager.id }}{% endif %}"
                                            data-value="{% if entity.lineManager.id is defined and entity.lineManager.id is not empty %}{{ entity.lineManager.id }}{% endif %}"
                                            data-original-title="Select Line Manager">
                                        {% if entity.lineManager.name is defined and entity.lineManager.name is not empty %}
                                            {{ entity.lineManager.name|default('') }}
                                        {% endif %}
                                    </a>
                                </td>
                                <td>
                                    <a
                                            data-type="select"
                                            class="editable"
                                            id="reportMode-{% if entity.reportMode.id is defined and entity.reportMode.id is not empty %}{{ entity.reportMode.id }}{% endif %}"
                                            data-name="reportMode"
                                            href="#"
                                            data-source="{{ path('kpi_report_mode_select',{id:entity.id}) }}"
                                            data-url="{{ path('kpi_report_mode_inline_update',{id:entity.id}) }}"
                                            data-pk="{% if entity.reportMode.id is defined and entity.reportMode.id is not empty %}{{ entity.reportMode.id }}{% endif %}"
                                            data-value="{% if entity.reportMode.id is defined and entity.reportMode.id is not empty %}{{ entity.reportMode.id }}{% endif %}"
                                            data-original-title="Select Report Mode">
                                        {% if entity.reportMode.name is defined and entity.reportMode.name is not empty %}
                                            {{ entity.reportMode.name|default('') }}
                                        {% endif %}
                                    </a>
                                </td>
                                <td>
                                    <a
                                            data-type="text"
                                            class="editable"
                                            id="password-{{ entity.id }}"
                                            data-name="price"
                                            href="javascript:"
                                            data-url="{{ path('kpi_employee_inline_password',{'id':entity.id}) }}"
                                            data-pk="{{ entity.id }}"
                                            data-value="">password</a>
                                </td>
                                <td>{{ entity.mobile }}</td>
                                <td>
                                    {% if entity.district is not empty %}
                                        {% for dist in entity.district %}
                                            {{ dist.name }}
                                            {% if loop.last!=1 %}{{ ',' }}{% endif %}
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                <td>{{ entity.username }}</td>
                                <td>{{ entity.department.name|default('') }}</td>
                                <td>{{ entity.enabled == 1 ? "Enabled":"Disabled" }}</td>
                                {#<td>{{ entity.customerGroup.name }}</td>#}
                                {#<td>{% if entity.agent is not empty %}{{ entity.agent.name }}{% endif %}</td>#}
                                {#<td>{% if  entity.location is not empty %}{{ entity.location.name }}{% endif %}</td>#}
                                <td>
                                    <a class="btn btn-mini yellow-bg white-font" href="{{ path('kpi_employee_edit',{'id':entity.id}) }}"><i class="feather icon-edit"></i> Edit</a>
                                    <a class="btn btn-mini purple-bg white-font" href="{{ path('kpi_employee_password',{'id':entity.id}) }}"><i class="feather icon-lock"></i> Chhange Password</a>
                                </td>

                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
{% block cssBlock %}
    <link rel="stylesheet" href="{{ asset('assets/plugins/bootstrap-editable/css/bootstrap-editable.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script type="application/javascript"  src="{{ asset('assets/plugins/bootstrap-editable/js/bootstrap4-editable.js') }}"></script>

{% endblock  %}
{% block documentready %}

    {{ parent() }}
    $('#datatable').DataTable( {
    "pageLength": 100,
    'columnDefs': [ {
    'targets': [0,8],
    'orderable': false
    }]
    });



    $.fn.editable.defaults.mode ='inline';
{#    $.fn.editable.defaults.mode = 'popover';#}
    $('.editable').editable();

{% endblock %}
