                                                        {% endfor %}
                                                    </select>
                                                </th>
{#                                                <th width="40%">#}
{#                                                    <input type="text" name="monthYear"#}
{#                                                           id="monthYearKpiStatisticsFilter"#}
{#                                                           value="{{ month ~','~ year }}"#}
{#                                                           placeholder="Month,Year" class="inputMonth form-control"#}
{#                                                           autocomplete="off">#}
{#                                                </th>#}
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'Start'|trans|upper }}</h6>
                                                    <input type="text" name="startMonthYear" id="startMonthYearKpiStatisticsFilter"
                                                           value=""
                                                           placeholder="Month,Year" class="inputMonth form-control"
                                                           autocomplete="off">
                                                </th>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'End'|trans|upper }}</h6>
                                                    <input type="text" name="endMonthYear" id="endMonthYearKpiStatisticsFilter"
