{% block body %}
    <div class="pcoded-inner-content">
        <div class="row">
            <div class="card mb-1">
                <div class="card-header p-2">
                    <h5>KPI Statistics</h5>
{#                    <button class="btn btn-sm btn-warning float-right print"><i class="fa fa-print"></i> Print</button>#}
                </div>
                <div class="card-body" id="print-area">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row" id="top-ten-filter">
                                <div class="col">
{#                                    <h6 class="mb-0">{{ 'Top 10 People'|trans|upper }}</h6>#}
                                    <form action="{{ path('kpi_statistics_top_ten_refresh') }}"
                                          id="kpiStatisticsTopTenFilterForm" method="post">
                                        <table width="100%">
                                            <thead>
                                            <tr>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'Top 10 People (Avg.)'|trans|upper }}</h6>
                                                    <select name="topTenPeopleFormat" id="topTenPeopleFormat"
                                                            class="form-control" style="height: 31px !important;">
                                                        <option value="">- People -</option>
                                                        <option value="poultry-service">{{ 'Top 10 Poultry People'|trans }}</option>
                                                        <option value="aqua-service">{{ 'Top 10 Fish People'|trans }}</option>
                                                        <option value="cattle-service">{{ 'Top 10 Cattle People'|trans }}</option>
                                                        <option value="spo-format">{{ 'Top 10 Sales People'|trans }}</option>
                                                    </select>
                                                </th>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'Start'|trans|upper }}</h6>
                                                    <input type="text" name="startMonthYear" id="startMonthYearTopTenFilter"
                                                           value=""
                                                           placeholder="Month,Year" class="inputMonth form-control"
                                                           autocomplete="off">
                                                </th>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'End'|trans|upper }}</h6>
                                                    <input type="text" name="endMonthYear" id="endMonthYearTopTenFilter"
                                                           value=""
                                                           placeholder="Month,Year" class="inputMonth form-control"
                                                           autocomplete="off">
                                                </th>
                                                <th width="10%">
                                                    <div class="btn-group" style="margin-top: 17px">
                                                        <button type="submit" class="btn btn-primary btn-sm"><i
                                                                    class="fa fa-search"></i></button>
{#                                                        <a href="{{ path('kpi_statistics_index') }}"#}
{#                                                           class="btn purple-bg btn-sm white-font" title="Reset"#}
{#                                                           value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>#}
                                                        <button type="reset" id="kpi-statistics-top-ten-reset"
                                                                class="btn purple-bg btn-sm white-font reset"
                                                                title="Reset"
                                                                value="reset"><i class="fa fa-refresh"
                                                                                 aria-hidden="true"></i></button>
                                                    </div>

                                                </th>
                                            </tr>
                                            </thead>
                                        </table>
                                    </form>
                                </div>
                            </div>
                            <div class="row mb-3" id="kpi-statistics-top-ten-refresh-area"></div>
                        </div>


                        <div class="col-md-6">
                            <div class="row">
                                <div class="col">
{#                                    <h6 class="mb-0">{{ 'Bottom 10 People'|trans|upper }}</h6>#}
                                    <form action="{{ path('kpi_statistics_bottom_ten_refresh') }}"
                                          id="kpiStatisticsBottomTenFilterForm" method="post">
                                        <table width="100%">
                                            <thead>
                                            <tr>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'Bottom 10 People (Avg.)'|trans|upper }}</h6>
                                                    <select name="bottomTenPeopleFormat" id="bottomTenPeopleFormat"
                                                            class="form-control" style="height: 31px !important;">
                                                        <option value="">- People -</option>
                                                        <option value="poultry-service">{{ 'Bottom 10 Poultry People'|trans }}</option>
                                                        <option value="aqua-service">{{ 'Bottom 10 Fish People'|trans }}</option>
                                                        <option value="cattle-service">{{ 'Bottom 10 Cattle People'|trans }}</option>
                                                        <option value="spo-format">{{ 'Bottom 10 Sales People'|trans }}</option>
                                                    </select>
                                                </th>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'Start'|trans|upper }}</h6>
                                                    <input type="text" name="startMonthYear" id="startMonthYearBottomTenFilter"
                                                           value=""
                                                           placeholder="Month,Year" class="inputMonth form-control"
                                                           autocomplete="off">
                                                </th>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'End'|trans|upper }}</h6>
                                                    <input type="text" name="endMonthYear" id="endMonthYearBottomTenFilter"
                                                           value=""
                                                           placeholder="Month,Year" class="inputMonth form-control"
                                                           autocomplete="off">
                                                </th>
                                                <th width="10%">
                                                    <div class="btn-group" style="margin-top: 17px">
                                                        <button type="submit" class="btn btn-primary btn-sm"><i
                                                                    class="fa fa-search"></i></button>
                                                        <button type="reset" id="kpi-statistics-bottom-ten-reset"
                                                                class="btn purple-bg btn-sm white-font reset"
                                                                title="Reset"
                                                                value="reset"><i class="fa fa-refresh"
                                                                                 aria-hidden="true"></i></button>
                                                    </div>

                                                </th>
                                            </tr>
                                            </thead>
                                        </table>
                                    </form>
                                </div>
                            </div>
                            <div class="row mb-3" id="kpi-statistics-bottom-ten-refresh-area"></div>
                        </div>
                    </div>

                    {#<div id="data-loader-kpi-statistics-top-ten-area">#}
                    {#    <img src="{{ asset('/assets/images/loader-hen.gif') }}" alt="processing..."/>#}
                    {#    <p>Please Wait...</p>#}
                    {#</div>#}


                    <div class="row">
                        <div class="col-md-6"></div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col">
{#                                    <h6 class="mb-0">{{ 'KPI Status'|trans|upper }}</h6>#}
                                    <form action="{{ path('kpi_statistics_refresh') }}" id="kpiStatisticsFilterForm"
                                          method="post">
                                        <table width="100%">
                                            <thead>
                                            <tr>
                                                <th width="30%">
                                                    <h6 class="mb-0">{{ 'KPI Status'|trans|upper }}</h6>
                                                    <select name="reportFormat" id="reportFormat" class="form-control"
