{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script type="application/javascript" src="{{ asset('bundles/terminalbdkpi/js/kinzi.print.min.js') }}"></script>
    <script>

        //KPI statistics Filter
        $("#kpiStatisticsFilterForm").submit(function (e) {
            e.preventDefault();
            $("#data-loader-kpi-statistics-area").fadeIn();

            const reportFormatId = $("#reportFormat").val();
            const startMonthYear = $("#startMonthYearKpiStatisticsFilter").val();
            const endMonthYear = $("#endMonthYearKpiStatisticsFilter").val();
            const action = $("#kpiStatisticsFilterForm").attr("action");

            if (startMonthYear && endMonthYear) {
                $.ajax({
                    type: "POST",
                    url: action,
                    data: {reportFormatId: reportFormatId, startMonthYear: startMonthYear, endMonthYear: endMonthYear},
                    success: function (res) {
                        $("#data-loader-kpi-statistics-area").fadeOut();
                        $("#kpi-statistics-refresh-area").html(res.html);

                    }
                })
            }
        });

        //KPI statistics top ten Filter
        $("#kpiStatisticsTopTenFilterForm").submit(function (e) {
            e.preventDefault();
            const topTenPeopleFormatSlug = $("#topTenPeopleFormat").val();
            const startMonthYear = $("#startMonthYearTopTenFilter").val();
            const endMonthYear = $("#endMonthYearTopTenFilter").val();
            const action = $("#kpiStatisticsTopTenFilterForm").attr("action");


            if (startMonthYear && endMonthYear && topTenPeopleFormatSlug) {
                $.ajax({
                    type: "POST",
                    url: action,
                    data: {topTenPeopleFormatSlug: topTenPeopleFormatSlug, startMonthYear: startMonthYear, endMonthYear: endMonthYear},
                    success: function (res) {
                        $("#kpi-statistics-top-ten-refresh-area").html(res.html);

                    }
                })
            }
        });

        //KPI statistics bottom ten Filter
        $("#kpiStatisticsBottomTenFilterForm").submit(function (e) {
            e.preventDefault();
            const bottomTenPeopleFormatSlug = $("#bottomTenPeopleFormat").val();
            const startMonthYear = $("#startMonthYearBottomTenFilter").val();
            const endMonthYear = $("#endMonthYearBottomTenFilter").val();
            const action = $("#kpiStatisticsBottomTenFilterForm").attr("action");

            if (startMonthYear && endMonthYear && bottomTenPeopleFormatSlug) {
                $.ajax({
                    type: "POST",
                    url: action,
                    data: {bottomTenPeopleFormatSlug: bottomTenPeopleFormatSlug, startMonthYear: startMonthYear, endMonthYear: endMonthYear},
                    success: function (res) {
                        $("#kpi-statistics-bottom-ten-refresh-area").html(res.html);

                    }
                })
            }
        });

        // Top ten reset
        $("button#kpi-statistics-top-ten-reset").on("click", function () {
            $("#kpi-statistics-top-ten-refresh-area").html('');
        });

        // Bottom ten reset
        $("button#kpi-statistics-bottom-ten-reset").on("click", function () {
            $("#kpi-statistics-bottom-ten-refresh-area").html('');
        });

        // KPI statistics reset
        $("button#kpi-statistics-reset").on("click", function () {
            $("#kpi-statistics-refresh-area").html('');
        });

        // Print Page
/*        $("button.print").click(function () {
            $('#print-area').kinziPrint({
                importCSS: true,
                // header: $('.print-header-content').html(),
                // footer: $('.print-footer-content').html()
            });
        });*/


        // Month Year Picker
        $('.inputMonth').datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: 'MM,yy',
            yearRange: "2020:" + new Date().getFullYear(),

            onClose: function () {
                var iMonth = $("#ui-datepicker-div .ui-datepicker-month :selected").val();
                var iYear = $("#ui-datepicker-div .ui-datepicker-year :selected").val();
                $(this).datepicker('setDate', new Date(iYear, iMonth, 1));
            },

            beforeShow: function () {
                if ((selDate = $(this).val()).length > 0) {
                    iYear = selDate.substring(selDate.length - 4, selDate.length);
                    iMonth = jQuery.inArray(selDate.substring(0, selDate.length - 5), $(this).datepicker('option', 'monthNames'));
                    $(this).datepicker('option', 'defaultDate', new Date(iYear, iMonth, 1));
                    $(this).datepicker('setDate', new Date(iYear, iMonth, 1));
                }
            }
        });


    </script>
{% endblock %}
